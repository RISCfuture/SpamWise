    "Filtering paused": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtrado en pausa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Filtrage en pause"
          }
        }
      }
    },
    "Haiku 5.5 connection verified": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexión con Haiku 5.5 verificada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion à Haiku 5.5 vérifiée"
          }
        }
      }
    },
    "Not classified: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin clasificar: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non classé : %@"
          }
        }
      }
    },
    "Not classified: processing failed. Mail was left unchanged.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin clasificar: el procesamiento falló. El correo no se modificó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non classé : le traitement a échoué. Le message n’a pas été modifié."
          }
        }
      }
    },
    "Not classified: shared storage was unavailable.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin clasificar: el almacenamiento compartido no estaba disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non classé : le stockage partagé était indisponible."
          }
        }
      }
    },
    "Not classified: the message couldn’t be read.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin clasificar: no se pudo leer el mensaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non classé : impossible de lire le message."
          }
        }
      }
    },
    "Not classified: the monthly spending limit was reached, so nothing was sent to the provider.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin clasificar: se alcanzó el límite de gasto mensual, así que no se envió nada al proveedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non classé : la limite de dépenses mensuelle a été atteinte, donc rien n’a été envoyé au fournisseur."
          }
        }
      }
    },
    "Reason recorded by a different version of SpamWise": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Motivo registrado por otra versión de SpamWise"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Motif enregistré par une autre version de SpamWise"
          }
        }
      }
    },
    "Review: matches a campaign you marked as junk": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisar: coincide con una campaña que marcaste como no deseada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À vérifier : correspond à une campagne que vous avez marquée comme indésirable"
          }
        }
      }
    },
    "Review: part of the message couldn’t be read reliably": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisar: no se pudo leer parte del mensaje de forma fiable"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À vérifier : une partie du message n’a pas pu être lue de façon fiable"
          }
        }
      }
    },
    "Review: the sender’s address couldn’t be read": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisar: no se pudo leer la dirección del remitente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À vérifier : impossible de lire l’adresse de l’expéditeur"
          }
        }
      }
    },
    "Selected in Mail for correction": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccionado en Mail para corregirlo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionné dans Mail pour être corrigé"
          }
        }
      }
    },
    "Your correction for this sender’s address": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu corrección para la dirección de este remitente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre correction pour l’adresse de cet expéditeur"
          }
        }
      }
    },
    "Your correction for this sender’s domain": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu corrección para el dominio de este remitente"
          }
        },
        "fr": {
