            "state": "translated",
            "value": "Autorisé par votre règle pour le domaine de cet expéditeur"
          }
        }
      }
    },
    "Allowed: the sender is in your Contacts": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitido: el remitente está en tus Contactos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisé : l’expéditeur figure dans vos Contacts"
          }
        }
      }
    },
    "Allowed: this sender has sent authenticated order mail before": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitido: este remitente ya envió correo de pedidos autenticado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisé : cet expéditeur a déjà envoyé des messages de commande authentifiés"
          }
        }
      }
    },
    "Allowed: you have replied to this sender": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitido: has respondido a este remitente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisé : vous avez déjà répondu à cet expéditeur"
          }
        }
      }
    },
    "Already being processed": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya se está procesando"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjà en cours de traitement"
          }
        }
      }
    },
    "Already handled; the earlier decision is kept": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya gestionado; se conserva la decisión anterior"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjà traité ; la décision précédente est conservée"
          }
        }
      }
    },
