{
  "sourceLanguage": "en",
  "strings": {
    "Allowed by one of your content rules": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitido por una de tus reglas de contenido"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisé par l’une de vos règles de contenu"
          }
        }
      }
    },
    "Allowed by your content rule “%@”": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitido por tu regla de contenido «%@»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisé par votre règle de contenu « %@ »"
          }
        }
      }
    },
    "Allowed by your rule for this sender’s address": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitido por tu regla para la dirección de este remitente"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisé par votre règle pour l’adresse de cet expéditeur"
          }
        }
      }
    },
    "Allowed by your rule for this sender’s domain": {
      "localizations": {
