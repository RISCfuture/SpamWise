    "Quit and reopen SpamWise. Your saved data is left unchanged.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sal de SpamWise y vuelve a abrirlo. Tus datos guardados no se modifican."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quittez SpamWise et rouvrez-le. Vos données enregistrées restent inchangées."
