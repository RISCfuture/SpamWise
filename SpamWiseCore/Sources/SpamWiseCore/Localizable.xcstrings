        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message ne se trouve pas dans le dossier d’entraînement indiqué par son plan."
          }
        }
      }
    },
    "The message no longer matches its recorded state.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mensaje ya no coincide con su estado registrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message ne correspond plus à son état enregistré."
          }
        }
      }
    },
    "The message’s Activity record is no longer available.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro de Actividad del mensaje ya no está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’entrée d’activité du message n’est plus disponible."
          }
        }
      }
    },
    "The requested message or Mail service is unavailable.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mensaje o servicio de Mail solicitado no está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message ou le service Mail demandé est indisponible."
          }
        }
      }
    },
    "The reviewed example is no longer available.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El ejemplo revisado ya no está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’exemple vérifié n’est plus disponible."
          }
        }
      }
    },
    "The reviewed examples couldn’t be updated.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron actualizar los ejemplos revisados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de mettre à jour les exemples vérifiés."
          }
        }
      }
    },
    "The rule file is invalid or exceeds the import limit.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo de reglas no es válido o supera el límite de importación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier de règles est invalide ou dépasse la limite d’importation."
          }
        }
      }
    },
    "The sender rules could not be updated.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron actualizar las reglas de remitentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de mettre à jour les règles d’expéditeurs."
          }
        }
      }
    },
    "The spending limit must be a positive amount no greater than %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El límite de gasto debe ser un importe positivo no superior a %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La limite de dépenses doit être un montant positif ne dépassant pas %@."
          }
        }
      }
    },
    "The training folder holds more messages than SpamWise tracks.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta de entrenamiento contiene más mensajes de los que SpamWise registra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier d’entraînement contient plus de messages que SpamWise n’en suit."
          }
        }
      }
    },
    "The training folder placement couldn’t be applied.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo aplicar la colocación en la carpeta de entrenamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’appliquer le placement dans le dossier d’entraînement."
          }
        }
      }
    },
    "The trust exclusions couldn’t be saved.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron guardar las exclusiones de confianza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer les exclusions de confiance."
          }
        }
      }
    },
    "The trusted mail servers could not be updated.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron actualizar los servidores de correo de confianza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de mettre à jour les serveurs de messagerie de confiance."
          }
        }
      }
    },
    "This mail connection can’t perform the action, so it was not attempted.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conexión de correo no puede realizar la acción, así que no se intentó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette connexion de messagerie ne peut pas effectuer l’action ; elle n’a donc pas été tentée."
          }
        }
      }
    },
    "This month’s spending limit has been reached.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha alcanzado el límite de gasto de este mes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La limite de dépenses de ce mois-ci est atteinte."
          }
        }
      }
    },
    "This placement was already applied.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta colocación ya se aplicó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce placement a déjà été appliqué."
          }
        }
      }
    },
    "This request identifier was already used for a different request.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este identificador de solicitud ya se usó para otra solicitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet identifiant de demande a déjà servi pour une autre demande."
          }
        }
      }
    },
    "Uncertain classification; confidence is uncalibrated": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clasificación incierta; confianza sin calibrar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Classement incertain ; confiance non étalonnée"
          }
        }
      }
    },
    "Use the matching recovery key and a supported SpamWise backup.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la clave correspondiente y una copia compatible de SpamWise."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez la clé correspondante et une sauvegarde SpamWise compatible."
          }
        }
      }
    },
    "Your monthly spending limit prevented this request. Mail was left unchanged.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu límite de gasto mensual impidió esta solicitud. El correo no se ha modificado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre limite de dépenses mensuelle a empêché cette requête. Le message n’a pas été modifié."
          }
        }
      }
    },
    "“%@” has no registrable domain for a domain-wide rule.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» no tiene un dominio registrable para una regla de todo el dominio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » n’a pas de domaine enregistrable pour une règle portant sur tout le domaine."
          }
        }
      }
    },
    "“%@” is not a complete email address.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» no es una dirección de correo completa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » n’est pas une adresse e-mail complète."
