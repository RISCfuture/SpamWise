{
  "sourceLanguage": "en",
  "strings": {
    "An account can trust at most eight servers.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cuenta puede confiar en ocho servidores como máximo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte peut faire confiance à huit serveurs au maximum."
          }
        }
      }
    },
    "An earlier attempt with this request identifier did not finish, so it was not repeated.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un intento anterior con este identificador de solicitud no terminó, así que no se repitió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une tentative précédente avec cet identifiant de demande n’a pas abouti ; elle n’a donc pas été répétée."
          }
        }
      }
    },
    "Couldn’t confirm mark-as-read. The Junk move remains recorded; this step will not retry.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar la marca como leído. El movimiento a No deseado sigue registrado; este paso no se reintentará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de confirmer le marquage comme lu. Le déplacement vers Indésirables reste enregistré ; cette étape ne sera pas retentée."
          }
        }
      }
    },
    "Couldn’t save the folder plan.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el plan de carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer la configuration du dossier."
          }
        }
      }
    },
    "Couldn’t save the spending limit.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el límite de gasto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer la limite de dépenses."
          }
        }
      }
    },
    "Create a dedicated folder named “%@” in Mail, then select it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea en Mail una carpeta dedicada llamada “%@” y selecciónala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez dans Mail un dossier dédié nommé « %@ », puis sélectionnez-le."
          }
        }
      }
    },
    "Enter a complete email address or a registrable domain.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce una dirección de correo completa o un dominio registrable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une adresse e-mail complète ou un domaine enregistrable."
          }
        }
      }
    },
    "Enter at most %@ addresses.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe como máximo %@ direcciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez au maximum %@ adresses."
          }
        }
      }
    },
    "Enter at most %@ characters.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe como máximo %@ caracteres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez au maximum %@ caractères."
          }
        }
      }
    },
    "Enter each server as a single name, such as mx.google.com.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce cada servidor como un solo nombre, como mx.google.com."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez chaque serveur sous la forme d’un seul nom, comme mx.google.com."
          }
        }
      }
    },
    "Filtering is paused, or the training folder plan is off or unvalidated.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El filtrado está en pausa, o el plan de la carpeta de entrenamiento está desactivado o sin validar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le filtrage est en pause, ou le plan du dossier d’entraînement est désactivé ou non validé."
          }
        }
      }
    },
    "Forget imported examples you no longer need, then import again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvida los ejemplos importados que ya no necesites y vuelve a importar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oubliez les exemples importés dont vous n’avez plus besoin, puis importez à nouveau."
          }
        }
      }
    },
    "Import at most %@ messages at a time.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa como máximo %@ mensajes a la vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importez au maximum %@ messages à la fois."
          }
        }
      }
    },
    "Mail action needs attention": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La acción en Mail requiere atención"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’action dans Mail nécessite votre attention"
          }
        }
      }
    },
    "Mail could not complete the requested operation.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail no pudo completar la operación solicitada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail n’a pas pu terminer l’opération demandée."
          }
        }
      }
    },
    "Mail couldn’t identify this account’s mailbox uniquely.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail no pudo identificar de forma única el buzón de esta cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail n’a pas pu identifier de façon unique la boîte aux lettres de ce compte."
          }
        }
      }
    },
    "Mail didn’t respond in time. Any requested change may still happen; check the message in Mail.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail no respondió a tiempo. Es posible que el cambio solicitado aún se produzca; revisa el mensaje en Mail."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail n’a pas répondu à temps. La modification demandée peut encore avoir lieu ; vérifiez le message dans Mail."
          }
        }
      }
    },
    "Mail didn’t show the expected result before the observation window ended.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail no mostró el resultado esperado antes de que terminara el periodo de observación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail n’a pas affiché le résultat attendu avant la fin de la période d’observation."
          }
        }
      }
    },
    "Mail has more than %@ mailboxes or folders nested more than %@ levels deep.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Mail has more than %1$@ mailboxes or folders nested more than %2$@ levels deep."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail tiene más de %@ buzones o carpetas anidadas a más de %@ niveles de profundidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail contient plus de %@ boîtes aux lettres ou des dossiers imbriqués sur plus de %@ niveaux."
          }
        }
      }
    },
    "Mail has no unique account with the recorded identifier.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail no tiene una única cuenta con el identificador registrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail ne possède aucun compte unique correspondant à l’identifiant enregistré."
          }
        }
      }
    },
    "Mark-as-read status could not be saved. The confirmed Junk move is retained.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el estado de lectura. Se conserva el traslado confirmado a correo no deseado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer l’état de lecture. Le déplacement confirmé vers les indésirables est conservé."
          }
        }
      }
    },
    "Model and local evidence disagree": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo y los indicios locales discrepan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle et les indices locaux divergent"
          }
        }
      }
    },
    "More than one message matches the requested identity.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más de un mensaje coincide con la identidad solicitada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusieurs messages correspondent à l’identité demandée."
          }
        }
      }
    },
    "Move its messages elsewhere so the folder is empty, then save the plan again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve sus mensajes a otro lugar para vaciar la carpeta y vuelve a guardar el plan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacez ses messages ailleurs pour vider le dossier, puis enregistrez à nouveau la configuration."
          }
        }
      }
    },
    "Only an unclassified message can be retried.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se puede reintentar un mensaje sin clasificar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul un message non classé peut être réessayé."
          }
        }
      }
    },
    "Only an uncorrected dry-run preview can be applied.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se puede aplicar una vista previa de simulación sin corregir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul un aperçu de simulation non corrigé peut être appliqué."
          }
        }
      }
    },
    "Permission to control Mail was denied.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se denegó el permiso para controlar Mail."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation de contrôler Mail a été refusée."
          }
        }
      }
    },
    "Raise the limit in Settings, or wait until next month.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumenta el límite en Ajustes o espera al próximo mes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Augmentez la limite dans les Réglages ou attendez le mois prochain."
          }
        }
      }
    },
    "Remove a plan you no longer use, then try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina un plan que ya no uses y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimez une configuration que vous n’utilisez plus, puis réessayez."
          }
        }
      }
    },
    "Review corrections apply only to the sender’s address, not its domain.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las correcciones a Revisar solo se aplican a la dirección del remitente, no a su dominio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les corrections vers À vérifier ne s’appliquent qu’à l’adresse de l’expéditeur, pas à son domaine."
          }
        }
      }
    },
    "Rules, labels or settings changed after the correction was saved.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reglas, etiquetas o ajustes cambiaron después de guardar la corrección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des règles, étiquettes ou réglages ont changé après l’enregistrement de la correction."
          }
        }
      }
    },
    "Select %@ to %@ messages in Mail.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Select %1$@ to %2$@ messages in Mail."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona de %@ a %@ mensajes en Mail."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez de %@ à %@ messages dans Mail."
          }
        }
      }
    },
    "Select exactly one message in Mail.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona exactamente un mensaje en Mail."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez exactement un message dans Mail."
          }
        }
      }
    },
    "Select one message in the account’s Inbox whose subject starts with “[SpamWise Probe]”.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona un mensaje de la bandeja de entrada de la cuenta cuyo asunto empiece por «[SpamWise Probe]»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez un message de la boîte de réception du compte dont l’objet commence par « [SpamWise Probe] »."
          }
        }
      }
    },
    "SpamWise hasn’t seen enough of this account’s mail to detect its servers.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise aún no ha visto suficiente correo de esta cuenta para detectar sus servidores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise n’a pas encore vu assez de courrier de ce compte pour détecter ses serveurs."
          }
        }
      }
    },
    "SpamWise keeps at most %@ folder plans.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise conserva como máximo %@ planes de carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise conserve au maximum %@ configurations de dossier."
          }
        }
      }
    },
    "SpamWise keeps at most %@ imported labels; %@ more can be imported.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "SpamWise keeps at most %1$@ imported labels; %2$@ more can be imported."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise conserva como máximo %@ etiquetas importadas; se pueden importar %@ más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise conserve au maximum %@ étiquettes importées ; %@ de plus peuvent être importées."
          }
        }
      }
    },
    "SpamWise remembers at most %@ automation requests.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise recuerda como máximo %@ solicitudes de automatización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise retient au maximum %@ demandes d’automatisation."
          }
        }
      }
    },
    "The Activity record couldn’t be used.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo usar el registro de Actividad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’utiliser l’entrée d’activité."
          }
        }
      }
    },
    "The Activity record is no longer available.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El registro de Actividad ya no está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’entrée d’activité n’est plus disponible."
          }
        }
      }
    },
    "The Mail action failed or was cancelled; its result is unknown. Not retried.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La acción de Mail falló o se canceló; se desconoce su resultado. No se reintentará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’action Mail a échoué ou a été annulée ; son résultat est inconnu. Aucune nouvelle tentative."
          }
        }
      }
    },
    "The Mail action is unavailable.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La acción de Mail no está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’action Mail est indisponible."
          }
        }
      }
    },
    "The Mail action was not attempted; the message is unchanged.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se intentó la acción de Mail; el mensaje no ha cambiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’action Mail n’a pas été tentée ; le message est inchangé."
          }
        }
      }
    },
    "The account’s Inbox and Junk mailboxes haven’t been validated.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los buzones de Entrada y No deseado de la cuenta no se han validado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les boîtes Réception et Indésirables du compte n’ont pas été validées."
          }
        }
      }
    },
    "The automation request couldn’t be completed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar la solicitud de automatización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de terminer la demande d’automatisation."
          }
        }
      }
    },
    "The backup could not be opened.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir la copia de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde n’a pas pu être ouverte."
          }
        }
      }
    },
    "The configured account or folder could not be found uniquely. Select the folder again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo identificar de forma única la cuenta o carpeta configurada. Seleccione la carpeta de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le compte ou le dossier configuré n’a pas pu être identifié de façon unique. Sélectionnez à nouveau le dossier."
          }
        }
      }
    },
    "The correction couldn’t be saved.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar la corrección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer la correction."
          }
        }
      }
    },
    "The correction couldn’t be undone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo deshacer la corrección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’annuler la correction."
          }
        }
      }
    },
    "The folder plan no longer exists.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El plan de carpeta ya no existe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration du dossier n’existe plus."
          }
        }
      }
    },
    "The folder “%@” isn’t empty.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta “%@” no está vacía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier « %@ » n’est pas vide."
          }
        }
      }
    },
    "The folder “%@” isn’t named “%@”.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "The folder “%1$@” isn’t named “%2$@”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta “%1$@” no se llama “%2$@”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier « %1$@ » ne s’appelle pas « %2$@ »."
          }
        }
      }
    },
    "The mail operation failed. Mail stays unchanged.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La operación de correo falló. El correo no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’opération de messagerie a échoué. Les messages restent inchangés."
          }
        }
      }
    },
    "The maximum of 10,000 sender rules has been reached.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se alcanzó el máximo de 10.000 reglas de remitentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le maximum de 10 000 règles d’expéditeur a été atteint."
          }
        }
      }
    },
    "The message already has a flag or color you set, so SpamWise left it unchanged.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mensaje ya tiene una bandera o un color que estableciste, así que SpamWise no lo modificó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message porte déjà un drapeau ou une couleur que vous avez définis ; SpamWise ne l’a donc pas modifié."
          }
        }
      }
    },
    "The message couldn’t be found in Mail.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró el mensaje en Mail."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message est introuvable dans Mail."
          }
        }
      }
    },
    "The message has no Message-ID, so SpamWise can’t confirm a move and left it in place.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mensaje no tiene Message-ID, así que SpamWise no puede confirmar un traslado y lo dejó donde está."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message n’a pas de Message-ID ; SpamWise ne peut donc pas confirmer un déplacement et l’a laissé en place."
          }
        }
      }
    },
    "The message has no account or changed since it was selected.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mensaje no tiene cuenta o cambió desde que se seleccionó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message n’a pas de compte ou a changé depuis sa sélection."
          }
        }
      }
    },
    "The message has no single readable sender address.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mensaje no tiene una única dirección de remitente legible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message n’a pas d’adresse d’expéditeur unique lisible."
          }
        }
      }
    },
    "The message is no longer available in the mail client.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mensaje ya no está disponible en el cliente de correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message n’est plus disponible dans le client de messagerie."
          }
        }
      }
    },
    "The message is no longer in the mailbox where SpamWise found it, so it was left in place.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mensaje ya no está en el buzón donde SpamWise lo encontró, así que se dejó donde está."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message ne se trouve plus dans la boîte aux lettres où SpamWise l’a trouvé ; il a donc été laissé en place."
          }
        }
      }
    },
    "The message is too large for SpamWise to read, so it was left unchanged.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mensaje es demasiado grande para que SpamWise lo lea, así que no se modificó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message est trop volumineux pour que SpamWise le lise ; il n’a donc pas été modifié."
          }
        }
      }
    },
    "The message isn’t in the training folder its plan names.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mensaje no está en la carpeta de entrenamiento que indica su plan."
          }
