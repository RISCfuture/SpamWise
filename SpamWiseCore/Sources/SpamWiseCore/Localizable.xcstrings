{
  "sourceLanguage": "en",
  "strings": {
    "A newer version of SpamWise saved it in a format this version doesn’t read.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una versión más reciente de SpamWise los guardó en un formato que esta versión no lee."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une version plus récente de SpamWise les a enregistrées dans un format que cette version ne lit pas."
          }
        }
      }
    },
    "Allow SpamWise to control Mail in System Settings → Privacy & Security → Automation.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que SpamWise controle Mail en Ajustes del Sistema → Privacidad y seguridad → Automatización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez SpamWise à contrôler Mail dans Réglages Système → Confidentialité et sécurité → Automatisation."
          }
        }
      }
    },
    "An account can trust at most eight servers.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cuenta puede confiar en ocho servidores como máximo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un compte peut faire confiance à huit serveurs au maximum."
          }
        }
      }
    },
    "An earlier attempt with this request identifier did not finish, so it was not repeated.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un intento anterior con este identificador de solicitud no terminó, así que no se repitió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une tentative précédente avec cet identifiant de demande n’a pas abouti ; elle n’a donc pas été répétée."
          }
        }
      }
    },
    "Check the message in Mail.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa el mensaje en Mail."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez le message dans Mail."
          }
        }
      }
    },
    "Couldn’t communicate with Mail.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo comunicar con Mail."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de communiquer avec Mail."
          }
        }
      }
    },
    "Couldn’t confirm mark-as-read. The Junk move remains recorded; this step will not retry.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo confirmar la marca como leído. El movimiento a No deseado sigue registrado; este paso no se reintentará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de confirmer le marquage comme lu. Le déplacement vers Indésirables reste enregistré ; cette étape ne sera pas retentée."
          }
        }
      }
    },
    "Couldn’t save the folder plan.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el plan de carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer la configuration du dossier."
          }
        }
      }
    },
    "Couldn’t save the spending limit.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el límite de gasto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’enregistrer la limite de dépenses."
          }
        }
      }
    },
    "Create a dedicated folder named “%@” in Mail, then select it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea en Mail una carpeta dedicada llamada “%@” y selecciónala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créez dans Mail un dossier dédié nommé « %@ », puis sélectionnez-le."
          }
        }
      }
    },
    "Enter a complete email address or a registrable domain.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce una dirección de correo completa o un dominio registrable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez une adresse e-mail complète ou un domaine enregistrable."
          }
        }
      }
    },
    "Enter at most %lld addresses.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Enter at most %lld address."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Enter at most %lld addresses."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Escribe como máximo %lld de direcciones."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Escribe como máximo %lld dirección."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Escribe como máximo %lld direcciones."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Saisissez au maximum %lld d’adresses."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Saisissez au maximum %lld adresse."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Saisissez au maximum %lld adresses."
                }
              }
            }
          }
        }
      }
    },
    "Enter at most %lld characters.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Enter at most %lld character."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Enter at most %lld characters."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Escribe como máximo %lld de caracteres."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Escribe como máximo %lld carácter."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Escribe como máximo %lld caracteres."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Saisissez au maximum %lld de caractères."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Saisissez au maximum %lld caractère."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Saisissez au maximum %lld caractères."
                }
              }
            }
          }
        }
      }
    },
    "Enter each server as a single name, such as mx.google.com.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce cada servidor como un solo nombre, como mx.google.com."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez chaque serveur sous la forme d’un seul nom, comme mx.google.com."
          }
        }
      }
    },
    "Filtering is paused, or the training folder plan is off or unvalidated.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El filtrado está en pausa, o el plan de la carpeta de entrenamiento está desactivado o sin validar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le filtrage est en pause, ou le plan du dossier d’entraînement est désactivé ou non validé."
          }
        }
      }
    },
    "Forget imported examples you no longer need, then import again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvida los ejemplos importados que ya no necesites y vuelve a importar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oubliez les exemples importés dont vous n’avez plus besoin, puis importez à nouveau."
          }
        }
      }
    },
    "Import at most %lld messages at a time.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Import at most %lld message at a time."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Import at most %lld messages at a time."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Importa como máximo %lld de mensajes a la vez."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Importa como máximo %lld mensaje a la vez."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Importa como máximo %lld mensajes a la vez."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Importez au maximum %lld de messages à la fois."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Importez au maximum %lld message à la fois."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Importez au maximum %lld messages à la fois."
                }
              }
            }
          }
        }
      }
    },
    "Install the latest version of SpamWise.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala la versión más reciente de SpamWise."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez la dernière version de SpamWise."
          }
        }
      }
    },
    "Mail action needs attention": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La acción en Mail requiere atención"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’action dans Mail nécessite votre attention"
          }
        }
      }
    },
    "Mail could not complete the requested operation.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail no pudo completar la operación solicitada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail n’a pas pu terminer l’opération demandée."
          }
        }
      }
    },
    "Mail couldn’t identify this account’s mailbox uniquely.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail no pudo identificar de forma única el buzón de esta cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail n’a pas pu identifier de façon unique la boîte aux lettres de ce compte."
          }
        }
      }
    },
    "Mail didn’t respond in time, so a requested change may still happen.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail no respondió a tiempo, así que es posible que el cambio solicitado aún se produzca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail n’a pas répondu à temps ; la modification demandée peut donc encore avoir lieu."
          }
        }
      }
    },
    "Mail didn’t show the expected result before the observation window ended.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail no mostró el resultado esperado antes de que terminara el periodo de observación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail n’a pas affiché le résultat attendu avant la fin de la période d’observation."
          }
        }
      }
    },
    "Mail doesn’t have %lld to %lld messages selected.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail doesn’t have %1$lld to %#@arg2@ selected."
          },
          "substitutions": {
            "arg2": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg message"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg messages"
                    }
                  }
                }
              }
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail no tiene de %1$lld a %#@arg2@."
          },
          "substitutions": {
