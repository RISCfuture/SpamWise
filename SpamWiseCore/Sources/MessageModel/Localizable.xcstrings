{
  "sourceLanguage": "en",
  "strings": {
    "Couldn’t read the message.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el mensaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire le message."
          }
        }
      }
    },
    "The message exceeds the supported content limits.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mensaje supera los límites de contenido admitidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message dépasse les limites de contenu prises en charge."
          }
        }
      }
    },
    "The message has no single readable sender address.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mensaje no tiene una única dirección de remitente legible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message n’a pas d’adresse d’expéditeur unique lisible."
          }
        }
      }
    },
    "The operation timed out.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agotó el tiempo de espera de la operación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le délai de l’opération a expiré."
          }
        }
      }
    }
  },
  "version": "1.0"
}
