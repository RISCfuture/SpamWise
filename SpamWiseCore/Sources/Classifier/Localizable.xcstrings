          }
        }
      }
    },
    "What’s new and changelogs from apps and services": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Novedades y cambios de apps y servicios"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nouveautés et journaux des modifications d’apps et de services"
          }
        }
      }
    },
    "“How did we do?” and rating requests": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«¿Qué tal lo hicimos?» y solicitudes de valoración"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Comment avons-nous fait ? » et demandes de note"
          }
        }
      }
    },
    "“You left something in your cart”": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Dejaste algo en tu carrito»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Vous avez oublié quelque chose dans votre panier »"
