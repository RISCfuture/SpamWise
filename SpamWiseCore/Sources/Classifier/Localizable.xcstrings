{
  "sourceLanguage": "en",
  "strings": {
    "Allow mail sharing with the selected provider in Settings → Provider first.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero permite compartir el correo con el proveedor elegido en Ajustes → Proveedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez d’abord le partage des messages avec le fournisseur choisi dans Réglages → Fournisseur."
          }
        }
      }
    },
    "Apple Private Cloud Compute model": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelo de Private Cloud Compute de Apple"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modèle Private Cloud Compute d’Apple"
          }
        }
      }
    },
