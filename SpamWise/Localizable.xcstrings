            "state": "translated",
            "value": "Private Cloud Compute"
          }
        }
      }
    },
    "Probe failed or its outcome is uncertain. Inspect the message manually; no uncertain move is retried.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La prueba falló o su resultado es incierto. Inspecciona el mensaje manualmente; no se reintenta ningún movimiento incierto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le test a échoué ou son résultat est incertain. Vérifiez le message manuellement ; aucun déplacement incertain n’est retenté."
          }
        }
      }
    },
    "Probe restored to Inbox. Account validated; inspect the message before disabling dry run.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensaje de prueba restaurado en Entrada. Cuenta validada; inspecciona el mensaje antes de desactivar la simulación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Message de test restauré dans Réception. Compte validé ; vérifiez le message avant de désactiver la simulation."
          }
