    "Some saved SpamWise data couldn’t be read and was set aside. Restore a backup, or keep the current settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer algunos datos guardados de SpamWise y se apartaron. Restaura una copia de seguridad o conserva la configuración actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines données enregistrées de SpamWise n’ont pas pu être lues et ont été mises de côté. Restaurez une sauvegarde ou conservez les réglages actuels."
          }
        }
      }
    },
    "Provider data and retention terms": {
      "localizations": {
        "fr": {
          "stringUnit": {
