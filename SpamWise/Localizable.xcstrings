    },
    "Marking it as Good replaces your Block rule for %@ with an Allow rule.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcarlo como deseado sustituye tu regla de bloqueo para %@ por una regla de permitir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le marquer comme légitime remplace votre règle de blocage pour %@ par une règle d’autorisation."
          }
        }
      }
    },
    "Matching ignores capitalization. A rule that takes too long to check doesn’t match.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
