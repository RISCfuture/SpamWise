    "Keep filtering on this Mac is on, so SpamWise sends nothing to providers.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener el filtrado en este Mac está activado, así que SpamWise no envía nada a los proveedores."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder le filtrage sur ce Mac est activé, donc SpamWise n’envoie rien aux fournisseurs."
          }
        }
      }
    },
    "Keep in Inbox": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
