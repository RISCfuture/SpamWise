    "Automation permission denied. Allow SpamWise in System Settings → Privacy & Security → Automation.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permiso de Automatización denegado. Autoriza SpamWise en Ajustes del Sistema → Privacidad y seguridad → Automatización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisation Automatisation refusée. Autorisez SpamWise dans Réglages Système → Confidentialité et sécurité → Automatisation."
          }
        }
      }
    },
    "Availability depends on your Mac and Apple Intelligence settings. Private Cloud Compute also requires an approved entitlement. Refusals leave mail unchanged.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La disponibilidad depende del Mac y de los ajustes de Apple Intelligence. Private Cloud Compute también requiere una autorización aprobada. Los rechazos dejan el correo sin cambios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La disponibilité dépend de votre Mac et des réglages d’Apple Intelligence. Private Cloud Compute exige aussi une autorisation approuvée. Les refus laissent les messages inchangés."
          }
        }
      }
    },
