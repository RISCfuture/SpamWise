    "These are Mail.app roles. Matching names do not prove server labels. Keep dry run on while comparing filters.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son funciones de Mail.app. Los nombres coincidentes no confirman las etiquetas del servidor. Mantén la simulación al comparar filtros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sont les rôles de Mail.app. Des noms identiques ne prouvent pas les libellés du serveur. Gardez la simulation activée pour comparer les filtres."
          }
        }
      }
    },
