            "value": "Aide SpamWise"
          }
        }
      }
    },
    "SpamWise explains every decision. It never deletes mail or moves it to Trash. Uncertain mail stays in Inbox with an orange flag.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise explica cada decisión. Nunca elimina correo ni lo mueve a la Papelera. Los mensajes dudosos permanecen en la bandeja de entrada con una bandera naranja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise explique chaque décision. Aucun message n’est supprimé ni déplacé vers la Corbeille. Les messages incertains restent dans la boîte de réception avec un drapeau orange."
          }
        }
      }
    },
    "SpamWise setup": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuración de SpamWise"
          }
        },
        "fr": {
