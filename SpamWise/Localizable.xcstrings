    "SpamWise can’t open its data.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise no puede abrir sus datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise ne peut pas ouvrir ses données."
          }
        }
      }
    },
    "SpamWise can’t save changes or act on mail; mail stays unchanged.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise no puede guardar cambios ni actuar sobre el correo; el correo no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise ne peut pas enregistrer de modifications ni agir sur les messages ; les messages restent inchangés."
          }
        }
      }
    },
    "SpamWise couldn’t read or save its data.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise no pudo leer ni guardar sus datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise n’a pas pu lire ni enregistrer ses données."
          }
        }
      }
    },
    "SpamWise couldn’t read your contacts, so contacts it read earlier soon stop counting.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise no pudo leer tus contactos, así que los contactos que leyó antes dejarán de contar pronto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise n’a pas pu lire vos contacts ; ceux qu’il a lus auparavant cesseront bientôt de compter."
          }
        }
      }
    },
    "SpamWise is set to read mail over IMAP, and this action works only with Mail.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise está configurado para leer el correo por IMAP, y esta acción solo funciona con Mail."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise est configuré pour lire les messages via IMAP, et cette action ne fonctionne qu’avec Mail."
          }
        }
      }
    },
    "SpamWise isn’t allowed to control Mail.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise no tiene permiso para controlar Mail."
