            "state": "translated",
            "value": "Prueba una simulación para ver cómo se clasificará tu correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancez une simulation pour voir comment votre courrier sera classé."
          }
        }
      }
    },
    "Unavailable or failed evidence never counts as spam.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los indicios no disponibles o fallidos nunca cuentan como correo no deseado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les indices indisponibles ou en échec ne sont jamais considérés comme du courrier indésirable."
          }
        }
      }
    },
    "Uncalibrated thresholds: Conservative 99%, Balanced 95%, Aggressive 90%. Model confidence is not a probability.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Umbrales sin calibrar: Conservador 99 %, Equilibrado 95 %, Agresivo 90 %. La confianza del modelo no es una probabilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuils non étalonnés : Prudent 99 %, Équilibré 95 %, Agressif 90 %. La confiance du modèle n’est pas une probabilité."
          }
        }
      }
    },
