{
  "sourceLanguage": "en",
  "strings": {
    "%@ API key": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clave de API de %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clé API %@"
          }
        }
      }
    },
    "%@ on %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ en %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sur %2$@"
          }
        }
      }
    },
    "%@ Request UUID: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ UUID de solicitud: %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ UUID de la demande : %2$@"
          }
        }
      }
    },
    "%lld Block rules become Allow rules, including %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld reglas de bloqueo pasan a ser reglas de permitir, entre ellas %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld règles de blocage deviennent des règles d’autorisation, dont %2$@."
          }
        }
      }
    },
    "%lld Good or Junk · %lld Review · %lld not classified": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@arg1@ · %2$lld por revisar · %3$lld sin clasificar"
          },
          "substitutions": {
            "arg1": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg deseados o no deseados"
                    }
                  },
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg deseado o no deseado"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg deseados o no deseados"
                    }
                  }
                }
              }
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%#@arg1@ · %2$lld à vérifier · %#@arg3@"
          },
          "substitutions": {
            "arg1": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg légitimes ou indésirables"
                    }
                  },
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg légitime ou indésirable"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg légitimes ou indésirables"
                    }
                  }
                }
              }
            },
            "arg3": {
              "argNum": 3,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg non classés"
                    }
                  },
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg non classé"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg non classés"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "%lld messages": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld mensajes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld messages"
          }
        }
      }
    },
    "A backup holds your rules, additional instructions, corrections and learning, encrypted with a recovery key. Keys, passwords and spending stay on this Mac.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copia de seguridad contiene tus reglas, tus instrucciones adicionales, tus correcciones y el aprendizaje, cifrados con una clave de recuperación. Las claves, las contraseñas y el gasto se quedan en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une sauvegarde contient vos règles, vos instructions supplémentaires, vos corrections et l’apprentissage, chiffrés avec une clé de récupération. Les clés, les mots de passe et les dépenses restent sur ce Mac."
          }
        }
      }
    },
    "A lookup that fails never counts against a message.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una consulta que falla nunca cuenta en contra de un mensaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une recherche qui échoue ne compte jamais contre un message."
          }
        }
      }
    },
    "A preview shows what SpamWise would decide for %lld messages at a time, without moving any mail.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "A preview shows what SpamWise would decide for %lld message at a time, without moving any mail."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "A preview shows what SpamWise would decide for %lld messages at a time, without moving any mail."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Una vista previa muestra lo que SpamWise decidiría para %lld de mensajes a la vez, sin mover ningún correo."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Una vista previa muestra lo que SpamWise decidiría para %lld mensaje a la vez, sin mover ningún correo."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Una vista previa muestra lo que SpamWise decidiría para %lld mensajes a la vez, sin mover ningún correo."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Un aperçu montre ce que SpamWise déciderait pour %lld de messages à la fois, sans déplacer aucun message."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Un aperçu montre ce que SpamWise déciderait pour %lld message à la fois, sans déplacer aucun message."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Un aperçu montre ce que SpamWise déciderait pour %lld messages à la fois, sans déplacer aucun message."
                }
              }
            }
          }
        }
      }
    },
    "Account check progress": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Progreso de la comprobación de cuentas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Progression de la vérification des comptes"
          }
        }
      }
    },
    "Activity Statistics": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estadísticas de actividad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Statistiques d’activité"
          }
        }
      }
    },
    "Add or change a plan": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir o cambiar un plan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter ou modifier une configuration"
          }
        }
      }
    },
    "Additional instructions": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instrucciones adicionales"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Instructions supplémentaires"
          }
        }
      }
    },
    "Addresses that don’t count as people you know": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Direcciones que no cuentan como personas que conoces"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresses qui ne comptent pas comme des personnes que vous connaissez"
          }
        }
      }
    },
    "Advanced. Leave empty for a new request. To retry a run safely, enter the Request UUID its result or error shows.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avanzado. Déjalo vacío para una solicitud nueva. Para reintentar una ejecución de forma segura, introduce el UUID de solicitud que muestra su resultado o error."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avancé. Laissez vide pour une nouvelle demande. Pour réessayer une exécution sans risque, saisissez l’UUID de la demande indiqué dans son résultat ou son erreur."
          }
        }
      }
    },
    "Allow Domain": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir dominio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser le domaine"
          }
        }
      }
    },
    "Allow This Domain": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir este dominio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser ce domaine"
          }
        }
      }
    },
    "Anything the choices above don’t cover, in your own words, such as “Newsletters about aviation are fine.” Your instructions are sent to your selected provider with eligible messages.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que las opciones de arriba no cubren, con tus palabras, por ejemplo «Los boletines de aviación están bien». Tus instrucciones se envían al proveedor elegido con los mensajes que reúnen los requisitos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que les choix ci-dessus ne couvrent pas, avec vos mots, par exemple « Les infolettres sur l’aviation me conviennent ». Vos instructions sont envoyées au fournisseur choisi avec les messages concernés."
          }
        }
      }
    },
    "Apply Dates": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicar fechas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliquer les dates"
          }
        }
      }
    },
    "Backup restored. Filtering is paused with dry run on. Check Mail connection in Accounts, then resume.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia de seguridad restaurada. El filtrado está en pausa y la simulación activada. Comprueba la conexión con Mail en Cuentas y luego reanuda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegarde restaurée. Le filtrage est suspendu et la simulation activée. Vérifiez la connexion à Mail dans Comptes, puis reprenez."
          }
        }
      }
    },
    "Backups you already exported with the current key still need that key to restore.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las copias de seguridad que ya exportaste con la clave actual siguen necesitando esa clave para restaurarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes déjà exportées avec la clé actuelle auront toujours besoin de cette clé pour être restaurées."
          }
        }
      }
    },
    "Block Domain": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear dominio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquer le domaine"
          }
        }
      }
    },
    "Block This Domain": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquear este dominio"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloquer ce domaine"
          }
        }
      }
    },
    "Changes to rules, additional instructions and learning appear here.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí aparecen los cambios en reglas, instrucciones adicionales y aprendizaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications des règles, des instructions supplémentaires et de l’apprentissage apparaissent ici."
          }
        }
      }
    },
    "Check Connection": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobar conexión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifier la connexion"
          }
        }
      }
    },
    "Check Connection above to find your account address.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa Comprobar conexión arriba para encontrar la dirección de tu cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur Vérifier la connexion ci-dessus pour trouver l’adresse de votre compte."
          }
        }
      }
    },
    "Check Login Items in System Settings › General.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa Ítems de inicio en Ajustes del Sistema › General."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez Ouverture dans Réglages Système › Général."
          }
        }
      }
    },
    "Check Mail Connection": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobar conexión con Mail"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifier la connexion à Mail"
          }
        }
      }
    },
    "Check Mail Connection to find your account addresses.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba la conexión con Mail para encontrar las direcciones de tus cuentas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez la connexion à Mail pour trouver les adresses de vos comptes."
          }
        }
      }
    },
    "Check Mail Connection to show your accounts.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba la conexión con Mail para mostrar tus cuentas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez la connexion à Mail pour afficher vos comptes."
          }
        }
      }
    },
    "Check Mailboxes": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobar buzones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifier les boîtes aux lettres"
          }
        }
      }
    },
    "Check the connection so SpamWise can find the account’s Inbox and Junk before you turn off dry run.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba la conexión para que SpamWise encuentre los buzones de Entrada y No deseado de la cuenta antes de desactivar la simulación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez la connexion pour que SpamWise trouve les boîtes Réception et Indésirables du compte avant de désactiver la simulation."
          }
        }
      }
    },
    "Check the Mail connection so SpamWise can find each account’s Inbox and Junk before you turn off dry run.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba la conexión con Mail para que SpamWise encuentre los buzones de Entrada y No deseado de cada cuenta antes de desactivar la simulación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez la connexion à Mail pour que SpamWise trouve les boîtes Réception et Indésirables de chaque compte avant de désactiver la simulation."
          }
        }
      }
    },
    "Choose a folder": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una carpeta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier"
          }
        }
      }
    },
    "Choose senders": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir remitentes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir les expéditeurs"
          }
        }
      }
    },
    "Configure Folders…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurar carpetas…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurer les dossiers…"
          }
        }
      }
    },
    "Connect Contacts": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectar Contactos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecter Contacts"
          }
        }
      }
    },
    "Connected to Mail. Found the Inbox and Junk mailboxes for %lld of %lld accounts.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected to Mail. Found the Inbox and Junk mailboxes for %1$lld of %#@arg2@."
          },
          "substitutions": {
            "arg2": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg account"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg accounts"
                    }
                  }
                }
              }
            }
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado a Mail. Se encontraron los buzones de entrada y de correo no deseado de %1$lld de %#@arg2@."
          },
          "substitutions": {
            "arg2": {
              "argNum": 2,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg de cuentas"
                    }
                  },
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg cuenta"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg cuentas"
                    }
                  }
                }
              }
            }
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté à Mail. Boîtes de réception et d’indésirables trouvées pour %#@arg1@ sur %2$lld."
          },
          "substitutions": {
            "arg1": {
              "argNum": 1,
              "formatSpecifier": "lld",
              "variations": {
                "plural": {
                  "many": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg de comptes"
                    }
                  },
                  "one": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg compte"
                    }
                  },
                  "other": {
                    "stringUnit": {
                      "state": "translated",
                      "value": "%arg comptes"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "Connected, but SpamWise can’t move mail on this server. It needs IMAP MOVE support and exactly one Junk mailbox.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado, pero SpamWise no puede mover correo en este servidor. Necesita compatibilidad con IMAP MOVE y exactamente un buzón de correo no deseado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté, mais SpamWise ne peut pas déplacer de messages sur ce serveur. Il faut la prise en charge d’IMAP MOVE et exactement une boîte d’indésirables."
          }
        }
      }
    },
    "Connected. SpamWise found the Inbox and Junk mailboxes.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado. SpamWise encontró los buzones de entrada y de correo no deseado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté. SpamWise a trouvé les boîtes de réception et d’indésirables."
          }
        }
      }
    },
    "Connection saved with dry run on. Check the connection so SpamWise can find its Junk mailbox.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexión guardada con la simulación activada. Comprueba la conexión para que SpamWise encuentre su buzón de correo no deseado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion enregistrée avec la simulation activée. Vérifiez la connexion pour que SpamWise trouve sa boîte d’indésirables."
          }
        }
      }
    },
    "Contacts and history": {
      "localizations": {
