    "Body budget: ~%lld tokens": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Límite del cuerpo: ~%lld tokens"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite du corps : ~%lld tokens"
          }
        }
      }
    },
    "Body length uses a four-characters-per-token estimate. Quoted reply chains and attachments are omitted.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La longitud del cuerpo se estima en cuatro caracteres por token. Se omiten las respuestas citadas y los archivos adjuntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La longueur du corps est estimée à quatre caractères par token. Les réponses citées et les pièces jointes sont omises."
          }
        }
      }
    },
    "Cached tokens": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokens en caché"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokens en cache"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler"
          }
        }
      }
    },
    "Cancelled — no further actions requested.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelado — no se solicitaron más acciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulé — aucune action supplémentaire demandée."
          }
        }
      }
    },
    "Cancelling; mail stays unchanged unless an action was already requested.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelando; el correo no cambia salvo que ya se haya solicitado una acción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulation en cours ; les messages restent inchangés sauf si une action a déjà été demandée."
          }
        }
      }
    },
    "Check Mail connection": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobar conexión con Mail"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifier la connexion à Mail"
          }
        }
      }
    },
    "Check read-only connection": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobar conexión de solo lectura"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifier la connexion en lecture seule"
          }
        }
      }
    },
    "Checking the connection reads mailbox roles and Inbox status. It does not enable mail actions.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La comprobación lee las funciones de los buzones y el estado de Entrada. No activa acciones sobre el correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification lit les rôles des boîtes et l’état de Réception. Elle n’active pas les actions sur les messages."
          }
        }
      }
    },
    "Classification is unavailable. Mail was left unchanged.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clasificación no está disponible. El correo no se ha modificado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La classification est indisponible. Le courrier n’a pas été modifié."
          }
        }
      }
    },
