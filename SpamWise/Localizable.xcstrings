            "value": "Conditions de traitement et de conservation du fournisseur"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Condiciones de datos y conservación del proveedor"
          }
        }
      }
    },
    "Google’s unpaid-service terms allow model improvement and human review. Do not send personal mail under those terms. Confirm which terms apply to your project and region.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les conditions des services gratuits de Google autorisent l’amélioration des modèles et l’examen humain. N’envoyez pas de courrier personnel sous ces conditions. Vérifiez les conditions applicables à votre projet et à votre région."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las condiciones de los servicios gratuitos de Google permiten mejorar los modelos y la revisión humana. No envíe correo personal bajo esas condiciones. Confirme qué condiciones se aplican a su proyecto y región."
          }
        }
      }
    },
    "SpamWise couldn’t change its login item.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise no pudo cambiar su ítem de inicio."
