    "Anthropic Claude": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic Claude"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic Claude"
          }
        }
      }
    },
    "Anthropic receives your policy, correction examples, evidence, and a shortened message only when local rules do not decide it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic solo recibe tus preferencias, ejemplos de correcciones, indicios y un mensaje abreviado cuando las reglas locales no bastan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic reçoit vos préférences, des exemples de corrections, des indices et un message abrégé uniquement lorsque les règles locales ne suffisent pas."
          }
        }
      }
    },
    "Apple Mail": {
      "localizations": {
