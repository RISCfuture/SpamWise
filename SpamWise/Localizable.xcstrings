    "A local summary of unresolved Review items from the last seven days. No email is sent.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un resumen local de los mensajes para Revisar sin resolver de los últimos siete días. No se envía ningún correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un récapitulatif local des messages À vérifier non résolus des sept derniers jours. Aucun e-mail n’est envoyé."
          }
        }
      }
    },
    "A rule exceeded the time limit and did not match.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una regla superó el límite de tiempo y no coincidió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une règle a dépassé le délai et n’a pas correspondu."
          }
        }
      }
    },
