    },
    "Use your own API key. Verify sends a small synthetic message to Haiku 5.5 and saves the key in Keychain only if verification succeeds.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa tu propia clave de API. La verificación envía un pequeño mensaje ficticio a Haiku 5.5 y guarda la clave en el Llavero solo si se completa correctamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez votre propre clé API. La vérification envoie un petit message fictif à Haiku 5.5 et n’enregistre la clé dans le Trousseau qu’en cas de réussite."
          }
        }
      }
    },
