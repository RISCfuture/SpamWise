          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nouvelles règles : %lld"
          }
        }
      }
    },
    "No Junk mail was found to learn from. Check the Mail connection, then scan again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró correo no deseado del que aprender. Comprueba la conexión con Mail y vuelve a analizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun message indésirable dont apprendre n’a été trouvé. Vérifiez la connexion à Mail, puis relancez l’analyse."
          }
        }
      }
    },
    "Not saved. Shorten your instructions to %lld characters or fewer.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se guardó. Acorta tus instrucciones a %lld caracteres o menos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non enregistré. Raccourcissez vos instructions à %lld caractères ou moins."
          }
        }
      }
    },
    "Notifications resume when filtering resumes.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
