          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les experts : c’est le serveur nommé en premier dans l’en-tête Authentication-Results des messages que reçoit ce compte."
          }
        }
      }
    },
    "Found %lld messages from %lld senders.": {
