    },
    "Test selected disposable message": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Probar con el mensaje seleccionado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tester le message sélectionné"
          }
        }
      }
    },
    "Testing the selected message; allowing 30 seconds after each move for Mail to sync…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Probando el mensaje seleccionado; esperando 30 segundos tras cada movimiento para que Mail se sincronice…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Test du message sélectionné ; attente de 30 secondes après chaque déplacement pour la synchronisation de Mail…"
          }
        }
      }
    },
    "The maximum of 10,000 sender rules has been reached.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se alcanzó el máximo de 10.000 reglas de remitentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le maximum de 10 000 règles d’expéditeur a été atteint."
          }
        }
      }
    },
    "The rule file is invalid or exceeds the import limit.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo de reglas no es válido o supera el límite de importación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier de règles est invalide ou dépasse la limite d’importation."
          }
        }
      }
    },
    "The test moves to Junk and back. Verified restoration validates the account. Dry run stays unchanged.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La prueba mueve el mensaje a No deseado y lo devuelve. La restauración verificada valida la cuenta. La simulación no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le test déplace le message vers Indésirables puis le ramène. La restauration vérifiée valide le compte. La simulation reste inchangée."
          }
        }
      }
    },
    "Time": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hora"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Heure"
          }
        }
      }
    },
    "Token counts are measured when the provider exposes them. Dollar costs are estimates; cache-write premiums may differ.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tokens se miden cuando el proveedor facilita el recuento. Los costes en dólares son estimaciones; los recargos de escritura en caché pueden variar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tokens sont mesurés lorsque le fournisseur en communique le nombre. Les coûts en dollars sont des estimations ; les frais d’écriture en cache peuvent varier."
          }
        }
      }
    },
    "Troubleshooting Mail integration": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resolver problemas de integración con Mail"
          }
        },
