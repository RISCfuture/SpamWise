    "Each paid call reserves an upper bound before it starts. Commitments include failed calls and exceed estimated actual charges. Calls stop when the ceiling would be exceeded.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada llamada de pago reserva un importe máximo antes de empezar. Las reservas incluyen llamadas fallidas y superan los cargos reales estimados. Las llamadas se detienen si se superaría el límite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque appel payant réserve un montant maximal avant de commencer. Les réservations incluent les appels échoués et dépassent les frais réels estimés. Les appels s’arrêtent si le plafond serait dépassé."
          }
        }
      }
    },
