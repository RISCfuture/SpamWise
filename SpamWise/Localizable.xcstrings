          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder dans Réception"
          }
        }
      }
    },
    "Keys stay in Keychain until you remove them. Forget Connection removes a saved IMAP password.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves permanecen en el Llavero hasta que las eliminas. Olvidar conexión elimina una contraseña IMAP guardada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés restent dans le Trousseau jusqu’à ce que vous les supprimiez. Oublier la connexion supprime un mot de passe IMAP enregistré."
          }
        }
      }
    },
    "Kind of mail": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tipo de correo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Type de message"
          }
        }
      }
    },
    "Learn from your Junk folders": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprender de tus carpetas de correo no deseado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprendre de vos dossiers d’indésirables"
          }
        }
      }
    },
    "Learning from Junk folders is available with Apple Mail.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprender de las carpetas de correo no deseado está disponible con Apple Mail."
          }
        },
