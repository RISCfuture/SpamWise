    "Your selected provider receives a shortened message, your preferences, and relevant examples when local rules cannot decide.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proveedor seleccionado recibe un mensaje abreviado, tus preferencias y ejemplos relevantes cuando las reglas locales no pueden decidir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur sélectionné reçoit un message abrégé, vos préférences et des exemples pertinents lorsque les règles locales ne permettent pas de décider."
          }
        }
      }
    },
    "Your selected provider receives your policy, correction examples, evidence, and a shortened message only when local rules do not decide it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proveedor seleccionado solo recibe tus preferencias, ejemplos de correcciones, indicios y un mensaje abreviado cuando las reglas locales no bastan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fournisseur choisi reçoit vos préférences, des exemples de corrections, des indices et un message abrégé uniquement lorsque les règles locales ne suffisent pas."
          }
