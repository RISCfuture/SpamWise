    "Messages this rule couldn’t be checked against because its expression is invalid or took too long. The rule doesn’t match those messages.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensajes con los que no se pudo comprobar esta regla porque su expresión no es válida o tardó demasiado. La regla no coincide con esos mensajes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages pour lesquels cette règle n’a pas pu être vérifiée, car son expression n’est pas valide ou a pris trop de temps. La règle ne correspond pas à ces messages."
          }
        }
      }
    },
    "Move All to Junk": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover todos a No deseado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout déplacer dans Indésirables"
