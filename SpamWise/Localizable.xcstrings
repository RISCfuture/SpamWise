    "Contacts refresh failed — cached evidence expires after 24 hours": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron actualizar los contactos — los indicios en caché caducan a las 24 horas"
