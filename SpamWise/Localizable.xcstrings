    "Skip Unverified Senders": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omitir remitentes no verificados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorer les expéditeurs non vérifiés"
          }
        }
      }
    },
    "Skipped %lld.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se omitieron %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ignorés."
          }
        }
      }
    },
    "Skipped: SpamWise couldn’t read this message.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omitido: SpamWise no pudo leer este mensaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignoré : SpamWise n’a pas pu lire ce message."
          }
        }
      }
    },
    "Skipped: SpamWise couldn’t verify the sender, so it wasn’t blocked.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omitido: SpamWise no pudo verificar el remitente, así que no se bloqueó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignoré : SpamWise n’a pas pu vérifier l’expéditeur, qui n’a donc pas été bloqué."
          }
        }
      }
    },
    "Skipped: the sender has no domain that a rule can name.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omitido: el remitente no tiene un dominio que una regla pueda indicar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignoré : l’expéditeur n’a pas de domaine qu’une règle puisse désigner."
          }
        }
      }
    },
    "Skipped: unrelated people use %@. Correct this sender’s address from Activity instead.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omitido: personas sin relación usan %@. Corrige la dirección de este remitente desde Actividad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignoré : des personnes sans lien utilisent %@. Corrigez plutôt l’adresse de cet expéditeur depuis Activité."
          }
        }
      }
    },
    "SpamWise also forgets what it learned from them. Your sender rules stay.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise también olvida lo que aprendió de ellos. Tus reglas de remitente se mantienen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise oublie aussi ce qu’il en a appris. Vos règles d’expéditeur sont conservées."
          }
        }
      }
    },
    "SpamWise couldn’t read %@ as email messages.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise no pudo leer %@ como mensajes de correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise n’a pas pu lire %@ comme des e-mails."
          }
        }
      }
    },
    "SpamWise couldn’t read this message.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise no pudo leer este mensaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise n’a pas pu lire ce message."
          }
        }
      }
    },
    "SpamWise couldn’t verify that this message came from %@. If the address is forged, blocking it also sends the real sender’s mail to Junk.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise no pudo verificar que este mensaje venga de %@. Si la dirección está falsificada, bloquearla también envía a no deseado el correo del remitente real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise n’a pas pu vérifier que ce message vient de %@. Si l’adresse est usurpée, la bloquer envoie aussi les messages du véritable expéditeur dans les indésirables."
          }
        }
      }
    },
    "SpamWise couldn’t verify the senders of %lld of the %lld selected messages. If an address is forged, blocking it also sends the real sender’s mail to Junk.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise no pudo verificar los remitentes de %lld de los %lld mensajes seleccionados. Si una dirección está falsificada, bloquearla también envía a no deseado el correo del remitente real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise n’a pas pu vérifier les expéditeurs de %lld des %lld messages sélectionnés. Si une adresse est usurpée, la bloquer envoie aussi les messages du véritable expéditeur dans les indésirables."
          }
        }
      }
    },
    "SpamWise decides new mail from these senders without the rule. Mail already filtered stays where it is.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise decide el correo nuevo de estos remitentes sin la regla. El correo ya filtrado se queda donde está."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise traite les nouveaux messages de ces expéditeurs sans la règle. Les messages déjà filtrés restent où ils sont."
          }
        }
      }
    },
    "SpamWise didn’t put this message in Junk. Another filter or the mail server did.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise no puso este mensaje en no deseado. Lo hizo otro filtro o el servidor de correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise n’a pas placé ce message dans les indésirables. Un autre filtre ou le serveur de messagerie l’a fait."
          }
        }
      }
    },
    "SpamWise has no record of this message. It may have arrived before SpamWise started, or another filter or the mail server moved it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise no tiene registro de este mensaje. Puede que llegara antes de que SpamWise empezara, o que lo moviera otro filtro o el servidor de correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise n’a aucune trace de ce message. Il est peut-être arrivé avant le démarrage de SpamWise, ou un autre filtre ou le serveur de messagerie l’a déplacé."
          }
        }
      }
    },
    "SpamWise learns from messages you’ve checked yourself. Importing them never creates rules or moves mail.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise aprende de los mensajes que has revisado tú. Importarlos nunca crea reglas ni mueve correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise apprend des messages que vous avez vérifiés vous-même. Les importer ne crée jamais de règles et ne déplace aucun message."
          }
        }
      }
    },
    "SpamWise moved this message to Junk: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise movió este mensaje a no deseado: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise a déplacé ce message dans les indésirables : %@"
          }
        }
      }
    },
    "Stop Correcting": {
      "localizations": {
        "es": {
          "stringUnit": {
