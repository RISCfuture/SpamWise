    "%lld/4,000 characters": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld/4.000 caracteres"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld/4 000 caractères"
          }
        }
      }
    },
    "A local summary of unresolved Review items from the last seven days. No email is sent.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un resumen local de los mensajes para Revisar sin resolver de los últimos siete días. No se envía ningún correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un récapitulatif local des messages À vérifier non résolus des sept derniers jours. Aucun e-mail n’est envoyé."
          }
        }
      }
    },
    "API connection verification": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificación de conexión con la API"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérification de la connexion à l’API"
          }
        }
      }
    },
    "API key status: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estado de la clave de API: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "État de la clé API : %@"
          }
        }
      }
    },
    "API keys stay in Keychain. You can complete setup offline.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves API permanecen en el Llavero. Puedes completar la configuración sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés API restent dans le Trousseau. Vous pouvez terminer la configuration hors ligne."
          }
        }
      }
    },
