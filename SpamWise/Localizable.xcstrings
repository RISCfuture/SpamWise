    "Add an address or domain to always allow or block its mail.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una dirección o un dominio para permitir o bloquear siempre sus mensajes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une adresse ou un domaine pour toujours autoriser ou bloquer ses messages."
          }
        }
      }
    },
    "Add rule": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir regla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter une règle"
          }
        }
      }
    },
    "Address or registrable domain": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirección o dominio registrable"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresse ou domaine enregistrable"
          }
        }
      }
    },
    "Address rules take precedence over domain rules and trusted relationships.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reglas de dirección tienen prioridad sobre las de dominio y las relaciones de confianza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les règles d’adresse ont priorité sur les règles de domaine et les relations de confiance."
          }
        }
      }
    },
    "Address, then domain, then newest matching content rule, then trusted relationships.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirección, dominio, regla de contenido coincidente más reciente y relaciones de confianza, en ese orden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresse, domaine, règle de contenu correspondante la plus récente, puis relations de confiance."
          }
        }
      }
    },
    "Addresses excluded from automatic trust": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Direcciones excluidas de la confianza automática"
