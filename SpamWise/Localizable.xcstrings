    "Permission to control Mail was denied.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se denegó el permiso para controlar Mail."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’autorisation de contrôler Mail a été refusée."
          }
        }
      }
    },
    "Place a disposable [SpamWise Probe] message in Inbox. Enter its IMAP UID, not Apple Mail’s message number.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloca un mensaje prescindible [SpamWise Probe] en Entrada. Introduce su UID de IMAP, no el número de mensaje de Apple Mail."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez un message de test [SpamWise Probe] dans Réception. Saisissez son UID IMAP, pas le numéro de message d’Apple Mail."
          }
        }
      }
    },
    "Preferences": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferencias"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préférences"
          }
        }
      }
    },
    "Preview decisions before changing your mail. Uncertain messages stay in Inbox; SpamWise never deletes mail.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Previsualiza las decisiones antes de modificar el correo. Los mensajes dudosos permanecen en Entrada; SpamWise nunca elimina correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévisualisez les décisions avant de modifier votre courrier. Les messages incertains restent dans Réception ; SpamWise ne supprime jamais de courrier."
          }
        }
      }
    },
    "Preview up to 20 recent Inbox messages without changing them. Eligible messages use your selected provider and may incur API charges.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Previsualiza hasta 20 mensajes recientes de Entrada sin modificarlos. Los mensajes aptos usan el proveedor seleccionado y pueden generar cargos de API."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévisualisez jusqu’à 20 messages récents de Réception sans les modifier. Les messages admissibles utilisent le fournisseur sélectionné et peuvent entraîner des frais d’API."
          }
        }
      }
    },
    "Private Cloud Compute": {
      "localizations": {
        "es": {
          "stringUnit": {
