          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’afficher le script de règle Mail."
          }
        }
      }
    },
    "Leave Request UUID empty to start a new request, or enter the UUID of an earlier run to retry it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja vacío el UUID de solicitud para iniciar una solicitud nueva, o introduce el UUID de una ejecución anterior para reintentarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez l’UUID de la demande vide pour lancer une nouvelle demande, ou saisissez l’UUID d’une exécution précédente pour la réessayer."
          }
        }
      }
    },
    "Mail doesn’t have exactly one message selected.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail no tiene exactamente un mensaje seleccionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail n’a pas exactement un message sélectionné."
          }
        }
      }
    },
    "No unresolved Review items in the last %lld days.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay elementos de Revisar sin resolver en los últimos %lld días."
