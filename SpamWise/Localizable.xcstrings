    "Marked as Good, but Mail couldn’t move the message. Move it in Mail.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcado como deseado, pero Mail no pudo mover el mensaje. Muévelo en Mail."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marqué comme légitime, mais Mail n’a pas pu déplacer le message. Déplacez-le dans Mail."
          }
        }
      }
    },
    "Marked as Good. Dry run is on, so the message stays in Junk.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcado como deseado. La simulación está activada, así que el mensaje se queda en no deseado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marqué comme légitime. La simulation est activée ; le message reste dans les indésirables."
          }
        }
      }
    },
    "Marked as Good. Filtering is paused, so the message stays in Junk.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcado como deseado. El filtrado está en pausa, así que el mensaje se queda en no deseado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marqué comme légitime. Le filtrage est suspendu ; le message reste dans les indésirables."
          }
        }
      }
    },
    "Marked as Good. Mail action: %@.": {
      "localizations": {
        "es": {
