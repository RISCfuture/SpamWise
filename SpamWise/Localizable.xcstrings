    "Backs up rules, policy, corrections and learning. Keep the recovery key separately; it cannot be recovered.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda reglas, política, correcciones y aprendizaje. Conserva la clave por separado; no se puede recuperar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegarde règles, politique, corrections et apprentissage. Conservez la clé séparément ; elle ne peut pas être récupérée."
          }
        }
      }
    },
