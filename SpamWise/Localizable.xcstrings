    "SpamWise": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise"
          }
        }
      }
    },
    "SpamWise Help": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayuda de SpamWise"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aide SpamWise"
          }
        }
      }
    },
    "SpamWise explains every decision. It never deletes mail or moves it to Trash. Uncertain mail stays in Inbox with an orange flag.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise explica cada decisión. Nunca elimina correo ni lo mueve a la Papelera. Los mensajes dudosos permanecen en la bandeja de entrada con una bandera naranja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise explique chaque décision. Aucun message n’est supprimé ni déplacé vers la Corbeille. Les messages incertains restent dans la boîte de réception avec un drapeau orange."
          }
        }
      }
    },
    "SpamWise setup": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuración de SpamWise"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuration de SpamWise"
          }
        }
      }
    },
    "Spending limit": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Límite de gasto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite de dépenses"
          }
        }
      }
    },
    "Statistical scores remain uncalibrated and require reviewed examples of both good and junk mail. Address and domain rules take precedence.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las puntuaciones estadísticas no están calibradas y requieren ejemplos revisados de correo deseado y no deseado. Las reglas de dirección y dominio tienen prioridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les scores statistiques restent non étalonnés et exigent des exemples révisés de messages légitimes et indésirables. Les règles d’adresse et de domaine ont priorité."
          }
        }
      }
    },
    "Step %lld of 4": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paso %lld de 4"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Étape %lld sur 4"
          }
        }
      }
    },
    "Stored only in Keychain. Saving does not make a paid request; use a dry run to verify.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda solo en el Llavero. Guardar no realiza una solicitud de pago; usa una simulación para verificar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrée uniquement dans le Trousseau. L’enregistrement n’effectue pas de requête payante ; utilisez une simulation pour vérifier."
          }
        }
      }
    },
    "Subject": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asunto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Objet"
          }
        }
      }
    },
    "Suggested domain preferences": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preferencias de dominio sugeridas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préférences de domaine suggérées"
          }
        }
      }
    },
    "Suggestions appear after consistent corrections across multiple senders on a domain.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sugerencias aparecen tras correcciones coherentes de varios remitentes de un dominio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les suggestions apparaissent après des corrections cohérentes concernant plusieurs expéditeurs d’un domaine."
          }
        }
      }
    },
    "Suggestions never change your rules until you apply them.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sugerencias no cambian tus reglas hasta que las apliques."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les suggestions ne changent jamais vos règles tant que vous ne les appliquez pas."
          }
        }
      }
    },
    "Superseded": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reemplazada"
          }
        },
