    "Sender corrections create address rules. Domain corrections apply to all senders on that registrable domain.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las correcciones de remitentes crean reglas de dirección. Las correcciones de dominio se aplican a todos los remitentes de ese dominio registrable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les corrections d’expéditeur créent des règles d’adresse. Les corrections de domaine s’appliquent à tous les expéditeurs de ce domaine enregistrable."
          }
        }
      }
    },
