    },
    "Your API key stays in Keychain. Start in dry run to see decisions before any mail changes.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu clave de API permanece en el Llavero. Empieza con una simulación para ver las decisiones antes de que cambie el correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre clé API reste dans le Trousseau. Commencez par une simulation pour voir les décisions avant toute modification des messages."
          }
