            "value": "Limite de dépenses"
          }
        }
      }
    },
    "Statistical scores remain uncalibrated and require reviewed examples of both good and junk mail. Address and domain rules take precedence.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las puntuaciones estadísticas no están calibradas y requieren ejemplos revisados de correo deseado y no deseado. Las reglas de dirección y dominio tienen prioridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les scores statistiques restent non étalonnés et exigent des exemples révisés de messages légitimes et indésirables. Les règles d’adresse et de domaine ont priorité."
          }
        }
      }
    },
