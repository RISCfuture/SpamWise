    "Select On-device to classify. The current provider is blocked by local mode.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona En el dispositivo para clasificar. El modo local bloquea el proveedor actual."
          }
        },
        "fr": {
