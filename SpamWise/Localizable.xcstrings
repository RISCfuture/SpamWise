        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’exécuter l’action SpamWise."
          }
        }
      }
    },
    "The script is missing from the SpamWise app.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta el script en la aplicación SpamWise."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le script est absent de l’app SpamWise."
          }
        }
      }
    },
    "Your rules, additional instructions, corrections and learning are replaced with the backup’s. Filtering pauses with dry run on until you check your accounts. Keys, passwords and spending stay as they are.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus reglas, tus instrucciones adicionales, tus correcciones y el aprendizaje se sustituyen por los de la copia. El filtrado se pausa con la simulación activada hasta que compruebes tus cuentas. Las claves, las contraseñas y el gasto se quedan como están."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos règles, vos instructions supplémentaires, vos corrections et l’apprentissage sont remplacés par ceux de la sauvegarde. Le filtrage est suspendu avec la simulation activée jusqu’à ce que vous vérifiiez vos comptes. Les clés, les mots de passe et les dépenses restent tels quels."
          }
        }
      }
    },
    "“%@” is larger than %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» ocupa más de %2$@."
