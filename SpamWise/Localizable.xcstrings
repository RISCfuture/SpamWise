{
  "sourceLanguage": "en",
  "strings": {
    "%@: %@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@: %@"
          }
        }
      }
    },
    "%lld accounts passed the action test. Dry run remains on until you turn it off in General.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld cuentas superaron la prueba de acciones. La simulación sigue activa hasta que la desactives en General."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld comptes ont réussi le test d’actions. La simulation reste activée jusqu’à sa désactivation dans Général."
          }
        }
      }
    },
    "%lld input · %lld output · %lld cached tokens (%@)": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld tokens de entrada · %lld de salida · %lld en caché (%@)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld tokens d’entrée · %lld de sortie · %lld en cache (%@)"
          }
        }
      }
    },
    "%lld%%": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld%%"
          }
        },
        "fr": {
