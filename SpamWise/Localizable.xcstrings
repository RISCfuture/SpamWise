    "Shared storage unavailable. Check signing and App Group access; mail stays unchanged.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Almacenamiento compartido no disponible. Comprueba la firma y el acceso al grupo de aplicaciones; el correo no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stockage partagé indisponible. Vérifiez la signature et l’accès au groupe d’applications ; les messages restent inchangés."
          }
        }
      }
    },
    "Shared storage unavailable; mail stays unchanged.": {
      "localizations": {
