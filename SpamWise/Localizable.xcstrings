    "Restore anything that isn’t junk. Nothing moves unless you choose Mark as Good.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura lo que no sea correo no deseado. Nada se mueve a menos que elijas Marcar como deseado."
          }
        },
        "fr": {
          "stringUnit": {
