    },
    "In a dry run, Activity shows what SpamWise would do and mail stays where it is. When you turn it off, SpamWise acts on the mail it checked that’s still in your Inbox.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En una simulación, Actividad muestra lo que haría SpamWise y el correo se queda donde está. Cuando la desactivas, SpamWise actúa sobre el correo revisado que sigue en tu buzón de entrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant une simulation, Activité montre ce que ferait SpamWise et les messages restent où ils sont. Quand vous la désactivez, SpamWise agit sur les messages examinés qui sont toujours dans votre boîte de réception."
          }
        }
      }
    },
    "Keeps the text of up to %lld reviewed messages on this Mac for export. Turning this off deletes the kept text; labels and learning remain.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Keeps the text of up to %lld reviewed message on this Mac for export. Turning this off deletes the kept text; labels and learning remain."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Keeps the text of up to %lld reviewed messages on this Mac for export. Turning this off deletes the kept text; labels and learning remain."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Conserva en este Mac el texto de hasta %lld de mensajes revisados para exportarlo. Al desactivarlo se elimina el texto conservado; las etiquetas y el aprendizaje se mantienen."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Conserva en este Mac el texto de hasta %lld mensaje revisado para exportarlo. Al desactivarlo se elimina el texto conservado; las etiquetas y el aprendizaje se mantienen."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Conserva en este Mac el texto de hasta %lld mensajes revisados para exportarlo. Al desactivarlo se elimina el texto conservado; las etiquetas y el aprendizaje se mantienen."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
