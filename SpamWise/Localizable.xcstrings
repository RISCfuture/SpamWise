    "Skipped: SpamWise couldn’t read this message.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omitido: SpamWise no pudo leer este mensaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignoré : SpamWise n’a pas pu lire ce message."
          }
        }
      }
    },
    "Skipped: SpamWise couldn’t verify the sender, so it wasn’t blocked.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omitido: SpamWise no pudo verificar el remitente, así que no se bloqueó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignoré : SpamWise n’a pas pu vérifier l’expéditeur, qui n’a donc pas été bloqué."
          }
        }
      }
    },
    "Skipped: the sender has no domain that a rule can name.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omitido: el remitente no tiene un dominio que una regla pueda indicar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignoré : l’expéditeur n’a pas de domaine qu’une règle puisse désigner."
          }
        }
      }
    },
    "Skipped: unrelated people use %@. Correct this sender’s address from Activity instead.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omitido: personas sin relación usan %@. Corrige la dirección de este remitente desde Actividad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignoré : des personnes sans lien utilisent %@. Corrigez plutôt l’adresse de cet expéditeur depuis Activité."
          }
        }
      }
    },
    "SpamWise also forgets what it learned from them. Your sender rules stay.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise también olvida lo que aprendió de ellos. Tus reglas de remitente se mantienen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise oublie aussi ce qu’il en a appris. Vos règles d’expéditeur sont conservées."
          }
        }
      }
    },
    "SpamWise couldn’t read %@ as email messages.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise no pudo leer %@ como mensajes de correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise n’a pas pu lire %@ comme des e-mails."
          }
        }
      }
    },
    "SpamWise couldn’t read this message.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise no pudo leer este mensaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise n’a pas pu lire ce message."
          }
        }
      }
    },
    "SpamWise couldn’t verify that this message came from %@. If the address is forged, blocking it also sends the real sender’s mail to Junk.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise no pudo verificar que este mensaje venga de %@. Si la dirección está falsificada, bloquearla también envía a no deseado el correo del remitente real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise n’a pas pu vérifier que ce message vient de %@. Si l’adresse est usurpée, la bloquer envoie aussi les messages du véritable expéditeur dans les indésirables."
          }
        }
      }
    },
