          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les corrections d’expéditeur créent des règles d’adresse. Les corrections de domaine s’appliquent à tous les expéditeurs de ce domaine enregistrable."
          }
        }
      }
    },
