    "Add an address or domain to always allow or block its mail.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una dirección o un dominio para permitir o bloquear siempre sus mensajes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une adresse ou un domaine pour toujours autoriser ou bloquer ses messages."
          }
        }
      }
    },
    "Add rule": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir regla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter une règle"
          }
        }
      }
    },
    "Address or registrable domain": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirección o dominio registrable"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresse ou domaine enregistrable"
          }
        }
      }
    },
    "Address rules take precedence over domain rules and trusted relationships.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reglas de dirección tienen prioridad sobre las de dominio y las relaciones de confianza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les règles d’adresse ont priorité sur les règles de domaine et les relations de confiance."
          }
        }
      }
    },
    "Advanced": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avanzado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avancé"
          }
        }
      }
    },
    "After validation, inspect the message before turning off dry run in General.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tras la validación, revisa el mensaje antes de desactivar la simulación en General."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après la validation, vérifiez le message avant de désactiver la simulation dans Général."
          }
        }
      }
    },
    "Aggressive": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agresivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agressif"
          }
        }
      }
    },
    "Allow": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser"
          }
        }
      }
    },
    "Allow Automation when asked. Enable SpamWise in Mail → Settings → Extensions.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite la automatización cuando se solicite. Activa SpamWise en Mail → Ajustes → Extensiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’automatisation lorsque cela vous est demandé. Activez SpamWise dans Mail → Réglages → Extensions."
          }
        }
      }
    },
    "Allow Automation when asked. In Mail → Settings → Extensions, enable SpamWise to inspect incoming dry runs.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite Automatización cuando se solicite. En Mail → Ajustes → Extensiones, activa SpamWise para simular el análisis del correo entrante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Automatisation lorsque vous y êtes invité. Dans Mail → Réglages → Extensions, activez SpamWise pour simuler l’analyse des messages entrants."
          }
        }
      }
    },
    "Allow SpamWise to control Mail in System Settings → Privacy & Security → Automation.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que SpamWise controle Mail en Ajustes del Sistema → Privacidad y seguridad → Automatización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez SpamWise à contrôler Mail dans Réglages Système → Confidentialité et sécurité → Automatisation."
          }
        }
      }
    },
    "Allow domain": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir dominio"
