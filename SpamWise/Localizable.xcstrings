    "Domain-age and Spamhaus lookups share only sender and link domain names, never message content.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las consultas de antigüedad de dominio y de Spamhaus solo comparten los nombres de dominio del remitente y de los enlaces, nunca el contenido de los mensajes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les recherches d’ancienneté de domaine et Spamhaus ne partagent que les noms de domaine de l’expéditeur et des liens, jamais le contenu des messages."
          }
        }
      }
    },
    "Don’t treat my own addresses as people I know": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tratar mis propias direcciones como personas que conozco"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne pas traiter mes propres adresses comme des personnes que je connais"
          }
        }
      }
    },
    "Dry run turns on, so mail stays unchanged until you turn it off in General. Automatic checks use the new connection from now on.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se activa la simulación, así que el correo no cambia hasta que la desactives en General. A partir de ahora, las comprobaciones automáticas usan la nueva conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La simulation s’active : les messages restent inchangés jusqu’à ce que vous la désactiviez dans Général. Les vérifications automatiques utilisent désormais la nouvelle connexion."
          }
        }
      }
    },
    "Each message’s sender, subject, shortened text and evidence are sent with your additional instructions and up to %lld similar corrections from the same account. Mail can contain sensitive information.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Each message’s sender, subject, shortened text and evidence are sent with your additional instructions and up to %lld similar correction from the same account. Mail can contain sensitive information."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Each message’s sender, subject, shortened text and evidence are sent with your additional instructions and up to %lld similar corrections from the same account. Mail can contain sensitive information."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Se envían el remitente, el asunto, el texto abreviado y las pruebas de cada mensaje, junto con tus instrucciones adicionales y hasta %lld de correcciones similares de la misma cuenta. El correo puede contener información confidencial."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Se envían el remitente, el asunto, el texto abreviado y las pruebas de cada mensaje, junto con tus instrucciones adicionales y hasta %lld corrección similar de la misma cuenta. El correo puede contener información confidencial."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Se envían el remitente, el asunto, el texto abreviado y las pruebas de cada mensaje, junto con tus instrucciones adicionales y hasta %lld correcciones similares de la misma cuenta. El correo puede contener información confidencial."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "L’expéditeur, l’objet, le texte abrégé et les indices de chaque message sont envoyés avec vos instructions supplémentaires et jusqu’à %lld de corrections similaires du même compte. Les messages peuvent contenir des informations sensibles."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "L’expéditeur, l’objet, le texte abrégé et les indices de chaque message sont envoyés avec vos instructions supplémentaires et jusqu’à %lld correction similaire du même compte. Les messages peuvent contenir des informations sensibles."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "L’expéditeur, l’objet, le texte abrégé et les indices de chaque message sont envoyés avec vos instructions supplémentaires et jusqu’à %lld corrections similaires du même compte. Les messages peuvent contenir des informations sensibles."
                }
              }
            }
          }
        }
      }
    },
