    "A rule for an address wins over a rule for its domain. Allow rules apply only to mail SpamWise can verify.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una regla para una dirección prevalece sobre la de su dominio. Las reglas de permitir solo se aplican al correo que SpamWise puede verificar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une règle pour une adresse l’emporte sur celle de son domaine. Les règles d’autorisation ne s’appliquent qu’aux messages que SpamWise peut vérifier."
          }
        }
      }
    },
