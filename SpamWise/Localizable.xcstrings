    },
    "The messages couldn’t be imported.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron importar los mensajes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’importer les messages."
          }
        }
      }
    },
    "This page has no messages to review.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta página no tiene mensajes que revisar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette page ne contient aucun message à vérifier."
          }
        }
      }
    },
    "This rule decides the selected message.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta regla decide el mensaje seleccionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette règle décide du message sélectionné."
          }
        }
      }
    },
    "This rule doesn’t decide the selected message.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta regla no decide el mensaje seleccionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette règle ne décide pas du message sélectionné."
          }
        }
      }
    },
    "This rule took too long to check, so it doesn’t match this message.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta regla tardó demasiado en comprobarse, así que no coincide con este mensaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette règle a été trop longue à vérifier ; elle ne correspond donc pas à ce message."
          }
        }
      }
    },
    "To stay within %lld examples, SpamWise forgets up to %lld of your oldest corrections as learning examples. Your sender rules stay.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para no superar %lld ejemplos, SpamWise olvida hasta %lld de tus correcciones más antiguas como ejemplos de aprendizaje. Tus reglas de remitente se mantienen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour ne pas dépasser %lld exemples, SpamWise oublie jusqu’à %lld de vos plus anciennes corrections comme exemples d’apprentissage. Vos règles d’expéditeur sont conservées."
          }
        }
      }
    },
    "Transfer Rules": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transferir reglas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transférer les règles"
          }
        }
      }
    },
    "Use this rule": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar esta regla"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser cette règle"
          }
        }
      }
    },
    "You marked this message as Junk.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marcaste este mensaje como no deseado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez marqué ce message comme indésirable."
          }
        }
      }
    },
    "Your Allow rule for %@ still sends this sender’s mail to the Inbox.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu regla de permitir para %@ sigue enviando el correo de este remitente a la bandeja de entrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre règle d’autorisation pour %@ envoie toujours les messages de cet expéditeur dans la boîte de réception."
          }
        }
      }
    },
    "Your Block rule for %@ matches this sender.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu regla de bloqueo para %@ coincide con este remitente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre règle de blocage pour %@ correspond à cet expéditeur."
          }
        }
      }
    },
    "Your Block rule for %@ stays, but mail from %@ will be allowed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu regla de bloqueo para %@ se mantiene, pero se permitirá el correo de %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre règle de blocage pour %@ est conservée, mais les messages de %@ seront autorisés."
          }
        }
      }
    },
    "Your Block rule for %@ still sends this sender’s mail to Junk.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu regla de bloqueo para %@ sigue enviando el correo de este remitente a no deseado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre règle de blocage pour %@ envoie toujours les messages de cet expéditeur dans les indésirables."
          }
        }
      }
    },
    "Your correction": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu corrección"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre correction"
          }
        }
      }
    },
    "Your corrections and the messages you import appear here.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí aparecen tus correcciones y los mensajes que importes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos corrections et les messages que vous importez apparaissent ici."
          }
        }
      }
    },
    "%lld of %lld characters": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld de %2$lld caracteres"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld sur %2$lld caractères"
          }
        }
      }
    },
    "OpenAI API key": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clave de API de OpenAI"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clé API OpenAI"
          }
        }
      }
    },
    "Gemini API key": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clave de API de Gemini"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clé API Gemini"
          }
        }
      }
    },
    "API key": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clave de API"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clé API"
          }
        }
      }
    },
    "Classification context": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contexto de clasificación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contexte de classification"
          }
        }
      }
    },
    "Diagnostics": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnóstico"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostic"
          }
        }
      }
    },
    "Each message’s sender, subject, shortened text and evidence are sent with your policy and up to %lld similar corrections from the same account. Mail can contain sensitive information.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se envían el remitente, el asunto, el texto abreviado y las pruebas de cada mensaje, junto con tu política y hasta %lld correcciones similares de la misma cuenta. El correo puede contener información confidencial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’expéditeur, l’objet, le texte abrégé et les indices de chaque message sont envoyés avec votre politique et jusqu’à %lld corrections similaires du même compte. Les messages peuvent contenir des informations sensibles."
          }
        }
      }
    },
    "Each week, lists Review messages from the last %lld days that you haven’t resolved. Nothing is emailed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada semana, enumera los mensajes para revisar de los últimos %lld días que no has resuelto. No se envía ningún correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque semaine, liste les messages à vérifier des %lld derniers jours que vous n’avez pas traités. Aucun e-mail n’est envoyé."
          }
        }
      }
    },
    "In a dry run, Activity shows what SpamWise would do and mail stays where it is. Mail checked during a dry run keeps that decision; correct it in Activity to move it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En una simulación, Actividad muestra lo que haría SpamWise y el correo se queda donde está. El correo revisado durante una simulación conserva esa decisión; corrígelo en Actividad para moverlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant une simulation, Activité montre ce que ferait SpamWise et les messages restent où ils sont. Les messages examinés pendant une simulation gardent cette décision ; corrigez-les dans Activité pour les déplacer."
          }
        }
      }
    },
    "Keeps the text of up to %lld reviewed messages on this Mac for export. Turning this off deletes the kept text; labels and learning remain.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva en este Mac el texto de hasta %lld mensajes revisados para exportarlo. Al desactivarlo se elimina el texto conservado; las etiquetas y el aprendizaje se mantienen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserve sur ce Mac le texte de %lld messages révisés au maximum pour l’exportation. Désactiver cette option supprime le texte conservé ; les étiquettes et l’apprentissage sont conservés."
          }
        }
      }
    },
    "Learn from words in corrected mail": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprender de las palabras del correo corregido"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprendre des mots des messages corrigés"
          }
        }
      }
    },
    "Learn which evidence matters most": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprender qué pruebas importan más"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apprendre quels indices comptent le plus"
          }
        }
      }
    },
    "Loading settings…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargando la configuración…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chargement des réglages…"
          }
        }
      }
    },
    "Local analysis": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Análisis local"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse locale"
          }
        }
      }
    },
    "Mail access": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acceso al correo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accès aux messages"
          }
        }
      }
    },
    "Mail is classified with Apple Intelligence on this Mac and isn’t sent anywhere.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El correo se clasifica con Apple Intelligence en este Mac y no se envía a ningún sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages sont classés avec Apple Intelligence sur ce Mac et ne sont envoyés nulle part."
          }
        }
      }
    },
    "Mail is classified with Apple Intelligence on this Mac. Network providers and lookups are off; Mail still syncs as usual.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El correo se clasifica con Apple Intelligence en este Mac. Los proveedores y las consultas de red están desactivados; Mail se sigue sincronizando como siempre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages sont classés avec Apple Intelligence sur ce Mac. Les fournisseurs et recherches en ligne sont désactivés ; Mail se synchronise toujours normalement."
          }
        }
      }
    },
    "Mail is sent to %@ for classification only after you allow it below.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El correo solo se envía a %@ para clasificarlo después de que lo permitas abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages ne sont envoyés à %@ pour classement qu’après votre autorisation ci-dessous."
          }
        }
      }
    },
    "Mail isn’t classified while this Mac is kept local and a network provider is selected. Select Apple on-device or turn off Keep filtering on this Mac.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El correo no se clasifica mientras el filtrado se mantenga en este Mac con un proveedor de red seleccionado. Selecciona Apple en el dispositivo o desactiva Mantener el filtrado en este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages ne sont pas classés tant que le filtrage reste sur ce Mac avec un fournisseur en ligne sélectionné. Sélectionnez Apple sur l’appareil ou désactivez Garder le filtrage sur ce Mac."
          }
        }
      }
    },
    "Mail sharing": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartir correo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partage des messages"
          }
        }
      }
    },
    "Mail will be classified with Apple Intelligence on this Mac instead of %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El correo se clasificará con Apple Intelligence en este Mac en lugar de con %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages seront classés avec Apple Intelligence sur ce Mac au lieu de %@."
          }
        }
      }
    },
    "Message text: about %lld tokens": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto del mensaje: unos %lld tokens"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte du message : environ %lld jetons"
          }
        }
      }
    },
    "More context can improve decisions but costs more with paid providers. Quoted replies are shortened, and attachment text is included only when you turn it on.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más contexto puede mejorar las decisiones, pero cuesta más con proveedores de pago. Las respuestas citadas se abrevian, y el texto de los adjuntos solo se incluye si lo activas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus de contexte peut améliorer les décisions, mais coûte plus cher avec les fournisseurs payants. Les réponses citées sont abrégées, et le texte des pièces jointes n’est inclus que si vous l’activez."
          }
        }
      }
    },
    "Move test": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba de traslado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Test de déplacement"
          }
        }
      }
    },
    "Network lookups": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultas de red"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherches en ligne"
          }
        }
      }
    },
    "No lookups are made until you accept the terms.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se hace ninguna consulta hasta que aceptes las condiciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune recherche n’est effectuée tant que vous n’acceptez pas les conditions."
          }
        }
      }
    },
    "Not saved. Enter an IPv4 address, such as %@.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha guardado. Introduce una dirección IPv4, como %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non enregistré. Saisissez une adresse IPv4, par exemple %@."
          }
        }
      }
    },
    "Not saved. Shorten your policy to %lld characters or fewer.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha guardado. Acorta tu política a %lld caracteres o menos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non enregistré. Raccourcissez votre politique à %lld caractères au maximum."
          }
        }
      }
    },
    "Notifications show counts, never message content. Set both quiet hours the same to turn quiet hours off.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones muestran recuentos, nunca el contenido de los mensajes. Para desactivar las horas de silencio, elige la misma hora en ambas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications indiquent des nombres, jamais le contenu des messages. Pour désactiver les heures calmes, choisissez la même heure pour les deux."
          }
        }
      }
    },
    "Only images inside the message are read; remote images are never downloaded. PDF and Office attachments aren’t read, and nothing in an attachment ever runs.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se leen las imágenes incluidas en el mensaje; las imágenes remotas nunca se descargan. Los adjuntos PDF y de Office no se leen, y nada de un adjunto se ejecuta nunca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les images intégrées au message sont lues ; les images distantes ne sont jamais téléchargées. Les pièces jointes PDF et Office ne sont pas lues, et rien dans une pièce jointe n’est jamais exécuté."
          }
        }
      }
    },
    "Only new mail is sent automatically; older mail is sent only when you preview it. Turning this off stops future requests, but requests already sent can’t be recalled.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo el correo nuevo se envía automáticamente; el correo anterior solo se envía cuando lo previsualizas. Al desactivarlo se detienen las solicitudes futuras, pero las ya enviadas no se pueden recuperar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les nouveaux messages sont envoyés automatiquement ; les messages plus anciens ne le sont que lorsque vous les prévisualisez. Désactiver cette option arrête les futures requêtes, mais celles déjà envoyées ne peuvent pas être rappelées."
          }
        }
      }
    },
    "Policy": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Política"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Politique"
          }
        }
      }
    },
    "Private Cloud Compute isn’t available. Select another provider.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Private Cloud Compute no está disponible. Selecciona otro proveedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Private Cloud Compute n’est pas disponible. Sélectionnez un autre fournisseur."
          }
        }
      }
    },
    "Query key": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clave de consulta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clé de requête"
          }
        }
      }
    },
    "Quiet until": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Silencio hasta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calme jusqu’à"
          }
        }
      }
    },
    "Recognize campaigns you marked as Junk": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconocer campañas que marcaste como No deseado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnaître les campagnes que vous avez marquées comme Indésirables"
          }
        }
      }
    },
    "Replace Policy": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reemplazar política"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacer la politique"
          }
        }
      }
    },
    "Replace your policy with the default?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Reemplazar tu política por la predeterminada?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplacer votre politique par celle par défaut ?"
          }
        }
      }
    },
    "Rspamd receives the whole message at %@, and its own configuration may use online services. A lookup that fails never counts against a message.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rspamd recibe el mensaje completo en %@, y su propia configuración puede usar servicios en línea. Una consulta que falla nunca cuenta en contra de un mensaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rspamd reçoit le message entier à l’adresse %@, et sa propre configuration peut utiliser des services en ligne. Une recherche qui échoue ne compte jamais contre un message."
          }
        }
      }
    },
    "Scan with my Rspamd server": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizar con mi servidor Rspamd"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyser avec mon serveur Rspamd"
          }
        }
      }
    },
    "Select one Inbox message whose subject begins “[SpamWise Probe]”. SpamWise moves it to Junk and back, then flags it orange, waiting up to %@ for Mail to show each move. Dry run isn’t changed.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona un mensaje de la bandeja de entrada cuyo asunto empiece por “[SpamWise Probe]”. SpamWise lo mueve a No deseado y de vuelta, y luego lo marca en naranja, esperando hasta %@ a que Mail muestre cada traslado. La simulación no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez un message de la boîte de réception dont l’objet commence par « [SpamWise Probe] ». SpamWise le déplace vers Indésirables puis le remet en place, et le signale en orange, en attendant jusqu’à %@ que Mail affiche chaque déplacement. La simulation reste inchangée."
          }
        }
      }
    },
    "Sender and link domains are shared with the selected service.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dominios de remitentes y enlaces se comparten con el servicio seleccionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les domaines d’expéditeurs et de liens sont partagés avec le service sélectionné."
          }
        }
      }
    },
    "Settings Unavailable": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuración no disponible"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages indisponibles"
          }
        }
      }
    },
    "Similar corrections: %lld": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Correcciones similares: %lld"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corrections similaires : %lld"
          }
        }
      }
    },
    "SpamWise learns from mail you mark Good or Junk once it has enough of each. Your sender rules always come first.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise aprende del correo que marcas como Deseado o No deseado cuando tiene suficiente de cada tipo. Tus reglas de remitente siempre tienen prioridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise apprend des messages que vous marquez comme Légitime ou Indésirables dès qu’il en a assez de chaque type. Vos règles d’expéditeur passent toujours en premier."
          }
        }
      }
    },
    "Spamhaus": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Spamhaus"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spamhaus"
          }
        }
      }
    },
    "Suggested domain rules": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reglas de dominio sugeridas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Règles de domaine suggérées"
          }
        }
      }
    },
    "Switch to the on-device model?": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Cambiar al modelo del dispositivo?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passer au modèle sur l’appareil ?"
          }
        }
      }
    },
    "The HTTPS service needs a subscription or trial key; free DNS keys may not include it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio HTTPS requiere una clave de suscripción o de prueba; es posible que las claves DNS gratuitas no lo incluyan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service HTTPS nécessite une clé d’abonnement ou d’essai ; les clés DNS gratuites peuvent ne pas l’inclure."
          }
        }
      }
    },
    "Unavailable while Keep filtering on this Mac is on in Classifier settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No disponible mientras Mantener el filtrado en este Mac esté activado en la configuración de Clasificador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indisponible tant que Garder le filtrage sur ce Mac est activé dans les réglages Classificateur."
          }
        }
      }
    },
    "Use On-Device Model": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar modelo del dispositivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser le modèle sur l’appareil"
          }
        }
      }
    },
    "With a limit set, paid classification pauses until next month once it is reached.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un límite definido, la clasificación de pago se pausa hasta el mes siguiente cuando se alcanza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec une limite définie, la classification payante est suspendue jusqu’au mois suivant une fois la limite atteinte."
          }
        }
      }
    },
    "Your current policy text will be replaced.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se reemplazará el texto actual de tu política."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte actuel de votre politique sera remplacé."
          }
        }
      }
    },
    "Your mail policy": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu política de correo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre politique de messagerie"
          }
        }
      }
    },
    "Save key": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar clave"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer la clé"
          }
        }
      }
    },
    "Verifying with %@…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificando con %@…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérification avec %@…"
          }
        }
      }
    },
    "Get an API key": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtener una clave de API"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenir une clé API"
          }
        }
      }
    },
    "A key is saved in Keychain. Enter a new one to replace it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una clave guardada en el Llavero. Introduce una nueva para reemplazarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une clé est enregistrée dans le Trousseau. Saisissez-en une nouvelle pour la remplacer."
          }
        }
      }
    },
    "SpamWise checks the key with one short test request to %@, which may incur a small API charge, then saves it only in Keychain.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise comprueba la clave con una breve solicitud de prueba a %@, que puede tener un pequeño coste de API, y la guarda solo en el Llavero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SpamWise vérifie la clé avec une courte requête de test à %@, qui peut entraîner un petit coût d’API, puis l’enregistre uniquement dans le Trousseau."
          }
        }
      }
    },
    "The key is saved only in Keychain, without a request. A dry run shows whether it works.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave se guarda solo en el Llavero, sin hacer ninguna solicitud. Una simulación muestra si funciona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé est enregistrée uniquement dans le Trousseau, sans requête. Une simulation indique si elle fonctionne."
          }
        }
      }
    },
    "Choose how SpamWise classifies mail": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige cómo clasifica SpamWise el correo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez comment SpamWise classe les messages"
          }
        }
      }
    },
    "Your rules and known senders decide most mail. The provider you choose classifies the rest.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus reglas y los remitentes conocidos deciden la mayor parte del correo. El proveedor que elijas clasifica el resto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos règles et les expéditeurs connus décident de la plupart des messages. Le fournisseur choisi classe le reste."
          }
        }
      }
    },
    "Messages your rules can’t decide are sent to %@ with your API key. Your provider account is charged for each one.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes que tus reglas no pueden decidir se envían a %@ con tu clave de API. Cada uno se cobra en tu cuenta del proveedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages que vos règles ne peuvent pas trancher sont envoyés à %@ avec votre clé API. Chacun est facturé sur votre compte du fournisseur."
          }
        }
      }
    },
    "Mail stays on this Mac, with no API key or charges. Requires Apple Intelligence.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El correo se queda en este Mac, sin clave de API ni costes. Requiere Apple Intelligence."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages restent sur ce Mac, sans clé API ni frais. Nécessite Apple Intelligence."
          }
        }
      }
    },
    "Ready to classify mail.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo para clasificar el correo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prêt à classer les messages."
          }
        }
      }
    },
    "To classify mail with %@, save an API key and allow mail sharing below.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para clasificar el correo con %@, guarda una clave de API y permite compartir el correo a continuación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour classer les messages avec %@, enregistrez une clé API et autorisez le partage des messages ci-dessous."
          }
        }
      }
    },
    "Filtering is set to stay on this Mac, which blocks cloud providers. Choose %@ or change this in Settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El filtrado está configurado para quedarse en este Mac, lo que bloquea los proveedores en la nube. Elige %@ o cámbialo en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le filtrage est configuré pour rester sur ce Mac, ce qui bloque les fournisseurs dans le cloud. Choisissez %@ ou modifiez ce réglage dans Réglages."
          }
        }
      }
    },
    "Apple Intelligence isn’t available on this Mac. Turn it on in System Settings, or choose another provider.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence no está disponible en este Mac. Actívalo en Ajustes del Sistema o elige otro proveedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence n’est pas disponible sur ce Mac. Activez-le dans Réglages Système ou choisissez un autre fournisseur."
          }
        }
      }
    },
    "This provider isn’t available. Choose another provider.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este proveedor no está disponible. Elige otro proveedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fournisseur n’est pas disponible. Choisissez-en un autre."
          }
        }
      }
    },
    "See what SpamWise would do with the %lld newest Inbox messages across your accounts. Nothing in Mail changes. Messages you’ve already previewed keep their result without a new request.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira qué haría SpamWise con los %lld mensajes más recientes de la bandeja de entrada de tus cuentas. Nada cambia en Mail. Los mensajes que ya simulaste conservan su resultado sin una nueva solicitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Découvrez ce que SpamWise ferait des %lld messages les plus récents de la boîte de réception de vos comptes. Rien ne change dans Mail. Les messages déjà simulés gardent leur résultat sans nouvelle requête."
          }
        }
      }
    },
    "Messages your rules can’t decide are sent to %@ and may incur API charges.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes que tus reglas no pueden decidir se envían a %@ y pueden tener costes de API."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages que vos règles ne peuvent pas trancher sont envoyés à %@ et peuvent entraîner des frais d’API."
          }
        }
      }
    },
    "Your provider isn’t set up, so only your rules and known senders decide messages. The rest stay unclassified.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu proveedor no está configurado, así que solo tus reglas y los remitentes conocidos deciden los mensajes. El resto queda sin clasificar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre fournisseur n’est pas configuré : seuls vos règles et les expéditeurs connus décident des messages. Les autres restent non classés."
          }
        }
      }
    },
    "Dry run stays on after setup. SpamWise records what it would do without changing mail until you turn dry run off in Settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La simulación sigue activada después de la configuración. SpamWise registra lo que haría sin cambiar el correo hasta que desactives la simulación en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La simulation reste activée après la configuration. SpamWise enregistre ce qu’il ferait sans modifier les messages jusqu’à ce que vous désactiviez la simulation dans Réglages."
          }
        }
      }
    },
    "Results": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Résultats"
          }
        }
      }
    },
    "No recent Inbox mail to preview.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay correo reciente en la bandeja de entrada para simular."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun message récent dans la boîte de réception à simuler."
          }
        }
      }
    },
    "Couldn’t be read": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron leer"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Illisibles"
          }
        }
      }
    },
    "Show in Activity": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar en Actividad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher dans Activité"
          }
        }
      }
    },
    "After setup, Activity shows each decision and why it was made.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después de la configuración, Actividad muestra cada decisión y su motivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après la configuration, Activité affiche chaque décision et son motif."
          }
        }
      }
    },
    "Some messages weren’t classified because mail sharing with %@ is off. Go back to allow it or choose another provider.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos mensajes no se clasificaron porque compartir el correo con %@ está desactivado. Vuelve atrás para permitirlo o elige otro proveedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains messages n’ont pas été classés, car le partage des messages avec %@ est désactivé. Revenez en arrière pour l’autoriser ou choisissez un autre fournisseur."
          }
        }
      }
    },
    "Some messages weren’t classified because no %@ API key is saved. Go back to add one.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos mensajes no se clasificaron porque no hay ninguna clave de API de %@ guardada. Vuelve atrás para añadirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains messages n’ont pas été classés, car aucune clé API %@ n’est enregistrée. Revenez en arrière pour en ajouter une."
          }
        }
      }
    },
    "Some messages weren’t classified because the selected provider isn’t available. Go back to choose another.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos mensajes no se clasificaron porque el proveedor seleccionado no está disponible. Vuelve atrás para elegir otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains messages n’ont pas été classés, car le fournisseur sélectionné n’est pas disponible. Revenez en arrière pour en choisir un autre."
          }
        }
      }
    },
    "Some messages weren’t classified because this month’s spending limit was reached.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos mensajes no se clasificaron porque se alcanzó el límite de gasto de este mes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains messages n’ont pas été classés, car la limite de dépenses de ce mois a été atteinte."
          }
        }
      }
    },
    "SpamWise Setup": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuración de SpamWise"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuration de SpamWise"
          }
        }
      }
    },
    "Step %lld of %lld": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paso %lld de %lld"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Étape %lld sur %lld"
          }
        }
      }
    },
    "Skip for now": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Omitir por ahora"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignorer pour l’instant"
          }
        }
      }
    },
    "Your rules and known senders are checked on this Mac. If you choose a cloud provider, messages they can’t decide are sent to it: a shortened message, your preferences, and up to %lld similar corrections from the same account, each with its sender domain, subject, a short excerpt and your label.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus reglas y los remitentes conocidos se comprueban en este Mac. Si eliges un proveedor en la nube, los mensajes que no pueden decidir se le envían: un mensaje abreviado, tus preferencias y hasta %lld correcciones similares de la misma cuenta, cada una con el dominio del remitente, el asunto, un breve extracto y tu etiqueta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos règles et les expéditeurs connus sont vérifiés sur ce Mac. Si vous choisissez un fournisseur dans le cloud, les messages qu’ils ne peuvent pas trancher lui sont envoyés : un message raccourci, vos préférences et jusqu’à %lld corrections similaires du même compte, chacune avec le domaine de l’expéditeur, l’objet, un court extrait et votre étiquette."
          }
        }
      }
    },
    "API keys are stored only in Keychain.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves de API se guardan solo en el Llavero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les clés API sont enregistrées uniquement dans le Trousseau."
          }
        }
      }
    },
    "%@": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        }
      }
    },
    "Allow SpamWise to control Mail in System Settings → Privacy & Security → Automation.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que SpamWise controle Mail en Ajustes del Sistema → Privacidad y seguridad → Automatización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez SpamWise à contrôler Mail dans Réglages Système → Confidentialité et sécurité → Automatisation."
          }
        }
      }
    },
    "Check Activity in SpamWise for details.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta la Actividad de SpamWise para ver los detalles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez l’Activité de SpamWise pour plus de détails."
          }
        }
      }
    },
    "Check Activity in SpamWise, then leave Request UUID empty to start a new request.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta la Actividad de SpamWise y deja vacío el UUID de solicitud para iniciar una solicitud nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez l’Activité de SpamWise, puis laissez l’UUID de la demande vide pour lancer une nouvelle demande."
          }
        }
      }
    },
    "Check that SpamWise is allowed in System Settings → Privacy & Security → Contacts, then try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba que SpamWise tenga permiso en Ajustes del Sistema → Privacidad y seguridad → Contactos y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que SpamWise est autorisé dans Réglages Système → Confidentialité et sécurité → Contacts, puis réessayez."
          }
        }
      }
    },
    "Choose Apple Mail as the connection in SpamWise Settings.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige Apple Mail como conexión en los Ajustes de SpamWise."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez Apple Mail comme connexion dans les Réglages de SpamWise."
          }
        }
      }
    },
    "Choose a smaller file.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un archivo más pequeño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un fichier plus petit."
          }
        }
      }
    },
    "Correct selected Mail as ${label}": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Corregir el correo seleccionado como ${label}"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Corriger le message sélectionné en ${label}"
          }
        }
      }
    },
    "Couldn’t read the file.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire le fichier."
          }
