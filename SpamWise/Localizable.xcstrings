    "Connected — %lld accounts readable. Actions need a disposable-message test.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conectado — %lld cuentas accesibles. Las acciones requieren una prueba con un mensaje prescindible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté — %lld comptes accessibles. Les actions nécessitent un test avec un message de test."
          }
        }
      }
    },
    "Connection saved. Dry run is enabled; validate the account before actions.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexión guardada. La simulación está activada; valida la cuenta antes de realizar acciones."
